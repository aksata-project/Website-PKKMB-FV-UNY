---
// src/pages/tata-tertib.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import PageHeader from "../components/ui/PageHeader.astro";
import {
  TATA_TERTIB_TITLE,
  GENERAL_RULES,
  DRESSCODE_TABLE,
  PROHIBITIONS,
  FINAL_GENERAL_POINTERS,
  VIOLATION_POINTS,
  PENALTY_TIERS,
  SPECIAL_SANCTIONS,
  APPROVAL_SHEETS,
} from "../data/tataTertib";
---

<BaseLayout
  title="Tata Tertib & Sanksi Peserta — PKKMB FV UNY 2026"
  description="Dokumen resmi Tata Tertib, Ketentuan Dresscode, Poin Pelanggaran, dan Sanksi Peserta PKKMB KM FV UNY 2026."
>
  <Navbar />

  <PageHeader
    title="Tata Tertib & Sanksi Peserta"
    subtitle="Dokumen Resmi Ketentuan, Dresscode, Poin Pelanggaran, dan Pengesahan PKKMB KM FV UNY 2026"
    badge="DOKUMEN PESERTA"
    badgeColor="gold"
  />

  <main class="py-12 bg-cokro-tint min-h-screen">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      
      <!-- Top Action Bar & Live Search -->
      <div class="bg-white rounded-card-lg border-2 border-cokro-navy p-6 shadow-3d-solid mb-10">
        <div class="flex flex-col md:flex-row items-center justify-between gap-4">
          <!-- Document Badge & Title info -->
          <div class="flex items-center gap-3 w-full md:w-auto">
            <div class="w-12 h-12 rounded-xl bg-cokro-header bg-doodle-pattern text-white flex items-center justify-center shrink-0 border-2 border-cokro-navy shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
            </div>
            <div>
              <h2 class="font-display font-bold text-lg text-cokro-navy leading-tight">
                Dokumen Resmi PKKMB KM FV UNY 2026
              </h2>
              <p class="font-body text-xs text-cokro-text-muted">
                Pedoman resmi tata tertib, ketentuan dresscode, serta sanksi kedisiplinan peserta PKKMB KM FV UNY 2026
              </p>
            </div>
          </div>

          <!-- Actions & Search -->
          <div class="flex flex-wrap items-center gap-3 w-full md:w-auto justify-end">
            <!-- Download Original PDF -->
            <a
              href="/Assets/docs/tata-tertib-pkkmb-2026.pdf"
              download="TATA TERTIB PESERTA PKKMB KM FV UNY 2026.pdf"
              target="_blank"
              class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-cokro-gold text-cokro-navy font-display font-bold text-sm rounded-xl border-2 border-cokro-navy shadow-3d-solid hover:-translate-y-0.5 active:translate-y-0 transition-all cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Unduh PDF Asli
            </a>

            <!-- Print Button -->
            <button
              id="print-btn"
              type="button"
              class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-white text-cokro-navy font-display font-semibold text-sm rounded-xl border-2 border-cokro-navy shadow-sm hover:bg-slate-50 transition-all cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
              Cetak Halaman
            </button>
          </div>
        </div>

        <!-- Search Input Bar -->
        <div class="mt-6 pt-6 border-t border-slate-100">
          <div class="relative max-w-2xl mx-auto">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </span>
            <input
              type="text"
              id="tata-tertib-search"
              placeholder="Cari aturan atau kata kunci (misal: batik, terlambat, kuku, rokok, makeup)..."
              class="w-full pl-10 pr-4 py-3 bg-slate-50 border-2 border-slate-200 focus:border-cokro-navy rounded-xl text-sm font-body text-cokro-navy placeholder:text-slate-400 focus:outline-none focus:bg-white transition-colors"
            />
          </div>
        </div>
      </div>

      <!-- ─── TOP NAVIGATION TABS (Mobile-friendly) ─── -->
      <div class="mb-8 bg-white/95 backdrop-blur-md rounded-card-lg border-2 border-cokro-navy p-2 sm:p-3 shadow-3d-solid">
        <div class="flex items-center justify-start sm:justify-center overflow-x-auto scroll-smooth gap-2 px-1 py-1 no-scrollbar">
          <button
            data-target="tab-rules"
            class="tab-btn active-tab px-4 sm:px-5 py-2.5 sm:py-3 font-display font-extrabold text-xs sm:text-sm rounded-xl border-2 border-cokro-navy bg-cokro-gold text-cokro-navy flex items-center gap-2 whitespace-nowrap shrink-0 transition-all shadow-sm cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
            1. Tata Tertib &amp; Dresscode
          </button>
          <button
            data-target="tab-sanctions"
            class="tab-btn px-4 sm:px-5 py-2.5 sm:py-3 font-display font-semibold text-xs sm:text-sm rounded-xl border-2 border-transparent text-cokro-text-muted hover:text-cokro-navy hover:bg-slate-100 flex items-center gap-2 whitespace-nowrap shrink-0 transition-all cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h18"/></svg>
            2. Sanksi &amp; Poin Pelanggaran
          </button>
          <button
            data-target="tab-approval"
            class="tab-btn px-4 sm:px-5 py-2.5 sm:py-3 font-display font-semibold text-xs sm:text-sm rounded-xl border-2 border-transparent text-cokro-text-muted hover:text-cokro-navy hover:bg-slate-100 flex items-center gap-2 whitespace-nowrap shrink-0 transition-all cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            3. Lembar Pengesahan
          </button>
        </div>
        <p class="sm:hidden text-center text-[10px] text-cokro-text-muted mt-1 font-body">← Geser tab ke kanan / kiri →</p>
      </div>

      <!-- ─── TAB 1: TATA TERTIB & DRESSCODE ─── -->
      <div id="tab-rules" class="tab-content space-y-10">
        <!-- Document Title Banner (Sesuai tema Header: Biru & Polkadot) -->
        <div class="bg-cokro-header bg-doodle-pattern text-white rounded-card-lg p-6 sm:p-8 border-2 border-cokro-navy shadow-3d-solid text-center relative overflow-hidden">
          <div class="absolute -right-6 -bottom-6 opacity-15 pointer-events-none">
            <svg xmlns="http://www.w3.org/2000/svg" width="160" height="160" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-white"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
          </div>
          <span class="inline-block px-3.5 py-1 bg-cokro-gold text-cokro-navy font-display font-extrabold text-xs rounded-pill uppercase tracking-widest mb-3 shadow-3d-solid">
            DOKUMEN RESMI TAHUN 2026
          </span>
          <h1 class="font-display font-black text-xl sm:text-2xl md:text-3xl text-white max-w-4xl mx-auto leading-tight drop-shadow-[2px_2px_0_#0A2540]">
            {TATA_TERTIB_TITLE}
          </h1>
        </div>

        <!-- Tata Tertib Poin 1 - 4 -->
        <div class="bg-white rounded-card-lg border-2 border-cokro-navy p-6 sm:p-8 shadow-3d-solid">
          <h2 class="sect-heading sect-heading-mb">
            <span class="badge-letter badge-letter-gold">A</span>
            Tata Tertib Umum Peserta
          </h2>

          <div class="space-y-4">
            {
              GENERAL_RULES.map((rule) => (
                <div class="searchable-item card-pair" style="padding:1rem; border-radius:0.75rem; background:#f8fafc; border:1px solid #e2e8f0;">
                  <span class="number-badge">{rule.id}</span>
                  <p style="font-size:0.9375rem; color:#1e293b; line-height:1.65;">{rule.title}</p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Tabel Dresscode Peserta (Laki-laki vs Perempuan) -->
        <div class="bg-white rounded-card-lg border-2 border-cokro-navy p-6 sm:p-8 shadow-3d-solid overflow-hidden">
          <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h2 class="sect-heading">
                <span class="badge-letter badge-letter-gold">B</span>
                Ketentuan Dresscode &amp; Pakaian Peserta
              </h2>
              <p class="font-body text-xs text-cokro-text-muted mt-1">
                Wajib dipatuhi oleh seluruh peserta Laki-laki dan Perempuan pada seluruh rangkaian kegiatan
              </p>
            </div>
            <span class="px-3 py-1 bg-cokro-tint border border-cokro-navy/20 text-cokro-navy font-display font-bold text-xs rounded-lg self-start sm:self-auto">
              Ketentuan Poin 5
            </span>
          </div>

          <!-- Table Container -->
          <div style="overflow-x:auto; border:2px solid #0A2540; border-radius:0.75rem;">
            <table class="tt-table" style="width:100%; min-width:640px;">
              <thead>
                <tr>
                  <th class="col-cat col-gold-header">Kategori</th>
                  <th class="col-gold-header" style="width:45%">
                    <span class="inline-flex items-center gap-1.5">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                      Laki-laki
                    </span>
                  </th>
                  <th class="col-gold-header" style="width:45%">
                    <span class="inline-flex items-center gap-1.5">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><path d="M20 21v-2a4 4 0 0 0-3-3.87"/><path d="M4 21v-2a4 4 0 0 1 3-3.87"/><circle cx="12" cy="7" r="4"/><path d="M12 11v10"/></svg>
                      Perempuan
                    </span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {
                  DRESSCODE_TABLE.map((row) => (
                    <tr class="searchable-item">
                      <td class="col-cat">{row.category}</td>
                      <td style="white-space:pre-line;">{row.male}</td>
                      <td style="white-space:pre-line;">{row.female}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>

        <!-- Larangan Selama Kegiatan (Poin 6) -->
        <div class="bg-white rounded-card-lg border-2 border-cokro-navy p-6 sm:p-8 shadow-3d-solid">
          <div class="mb-6">
            <h2 class="sect-heading">
              <span class="badge-letter badge-letter-red">C</span>
              Larangan Selama Kegiatan (Poin 6)
            </h2>
            <p class="font-body text-xs text-cokro-text-muted mt-1">
              Selama kegiatan PKKMB KM FV UNY 2026 berlangsung, peserta dilarang melakukan hal-hal berikut:
            </p>
          </div>

          <div style="display:grid; grid-template-columns:1fr; gap:0.75rem;">
            {
              PROHIBITIONS.map((item, idx) => (
                <div class="searchable-item card-pair" style="padding:0.875rem 1rem; border-radius:0.75rem; background:#fff5f5; border:1px solid #fecaca;">
                  <span class="number-badge" style="background:#ef4444; min-width:1.5rem; width:1.5rem; height:1.5rem; font-size:0.7rem;">{idx + 1}</span>
                  <p style="font-size:0.875rem; color:#1e293b; line-height:1.6;">{item}</p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Poin Penutup Tata Tertib (Poin 7 - 10) -->
        <div class="bg-white rounded-card-lg border-2 border-cokro-navy p-6 sm:p-8 shadow-3d-solid">
          <h2 class="sect-heading sect-heading-mb">
            <span class="badge-letter badge-letter-gold">D</span>
            Ketentuan Akhir (Poin 7 – 10)
          </h2>

          <div class="space-y-4">
            {
              FINAL_GENERAL_POINTERS.map((item, idx) => (
                <div class="searchable-item card-pair" style="padding:1rem; border-radius:0.75rem; background:#f8fafc; border:1px solid #e2e8f0;">
                  <span class="number-badge">{idx + 7}</span>
                  <p style="font-size:0.9375rem; color:#1e293b; line-height:1.65; font-weight:600;">{item}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <!-- ─── TAB 2: SANKSI & POIN PELANGGARAN ─── -->
      <div id="tab-sanctions" class="tab-content space-y-10" style="display:none">
        <!-- Title Banner -->
        <div class="bg-cokro-header bg-doodle-pattern text-white rounded-card-lg p-6 sm:p-8 border-2 border-cokro-navy shadow-3d-solid text-center relative overflow-hidden">
          <div class="absolute -right-6 -bottom-6 opacity-15 pointer-events-none">
            <svg xmlns="http://www.w3.org/2000/svg" width="160" height="160" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-white"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h18"/></svg>
          </div>
          <span class="inline-block px-3.5 py-1 bg-red-500 text-white font-display font-extrabold text-xs rounded-pill uppercase tracking-widest mb-3 shadow-3d-solid">
            SANKSI & POIN PELANGGARAN
          </span>
          <h2 class="font-display font-black text-xl sm:text-2xl md:text-3xl text-white max-w-4xl mx-auto drop-shadow-[2px_2px_0_#0A2540]">
            SANKSI PELANGGARAN PESERTA PKKMB KM FV UNY 2026
          </h2>
        </div>

        <!-- Bagian A: Tabel Poin Pelanggaran -->
        <div class="bg-white rounded-card-lg border-2 border-cokro-navy p-6 sm:p-8 shadow-3d-solid">
          <div class="mb-6">
            <h2 class="sect-heading">
              <span class="badge-letter badge-letter-navy">A</span>
              Tabel Poin Pelanggaran Peserta
            </h2>
            <p class="font-body text-xs text-cokro-text-muted mt-1">
              Daftar seluruh pelanggaran beserta bobot poin sanksi yang dihitung kumulatif
            </p>
          </div>

          <div class="overflow-x-auto no-scrollbar border-2 border-cokro-navy rounded-xl">
            <table class="w-full text-left border-collapse min-w-[600px]">
              <thead>
                <tr class="bg-cokro-blue text-white font-display text-xs sm:text-sm uppercase tracking-wider">
                  <th class="py-3.5 px-4 border-r border-white/20 w-16 text-center text-cokro-gold">NO</th>
                  <th class="py-3.5 px-4 border-r border-white/20 w-44 text-cokro-gold">KATEGORI</th>
                  <th class="py-3.5 px-5 border-r border-white/20 text-cokro-gold">DESKRIPSI PELANGGARAN</th>
                  <th class="py-3.5 px-4 text-center w-28 text-cokro-gold">BOBOT POIN</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 font-body text-xs sm:text-sm text-slate-800">
                {
                  VIOLATION_POINTS.map((item, idx) => (
                    <tr class={`searchable-item hover:bg-slate-50 transition-colors ${idx % 2 === 0 ? 'bg-white' : 'bg-slate-50/60'}`}>
                      <td class="py-3 px-4 font-display font-bold text-center border-r border-slate-200 text-slate-500">
                        {item.no}
                      </td>
                      <td class="py-3 px-4 font-display font-semibold border-r border-slate-200 text-cokro-navy">
                        {item.category}
                      </td>
                      <td class="py-3 px-5 border-r border-slate-200 leading-relaxed">
                        {item.description}
                      </td>
                      <td style="padding:0.75rem 1rem; text-align:center;">
                        <span class={`poin-badge ${
                          item.points >= 100 ? 'poin-red' :
                          item.points >= 50  ? 'poin-orange' :
                          item.points >= 20  ? 'poin-amber' :
                          'poin-slate'
                        }`}>
                          +{item.points} Poin
                        </span>
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>

        <!-- Bagian B: Tingkatan Sanksi Berdasarkan Poin -->
        <div class="bg-white rounded-card-lg border-2 border-cokro-navy p-6 sm:p-8 shadow-3d-solid">
          <div class="mb-6">
            <h2 class="sect-heading">
              <span class="badge-letter badge-letter-gold">B</span>
              Tingkatan Sanksi Akibat Poin Pelanggaran
            </h2>
            <p class="font-body text-xs text-cokro-text-muted mt-1">
              Sanksi yang wajib dilaksanakan peserta berdasarkan total akumulasi poin yang diperoleh
            </p>
          </div>

          <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:1.5rem;">
            {
              PENALTY_TIERS.map((tier, idx) => (
                <div class="searchable-item" style="background:#fff; border:2px solid #0A2540; border-radius:0.75rem; padding:1.25rem; display:flex; flex-direction:column; gap:0.75rem;">
                  <!-- Badge header -->
                  <div style="display:flex; align-items:center; justify-content:space-between; padding-bottom:0.75rem; border-bottom:1px solid #e2e8f0;">
                    <span style="font-size:0.7rem; font-weight:800; text-transform:uppercase; background:#f1f5f9; color:#64748b; border-radius:0.375rem; padding:0.2rem 0.5rem;">Tingkat {idx + 1}</span>
                    <span style={`font-size:0.8125rem; font-weight:900; padding:0.2rem 0.65rem; border-radius:9999px; ${
                      idx >= 4 ? 'background:#dc2626; color:#fff;' :
                      idx >= 2 ? 'background:#f59e0b; color:#fff;' :
                                 'background:#0A2540; color:#F5C842;'
                    }`}>{tier.range}</span>
                  </div>
                  <p style="font-size:0.75rem; font-weight:700; color:#0A2540; margin-bottom:0.25rem;">Konsekuensi / Sanksi Wajib:</p>
                  <ul style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:0.5rem;">
                    {tier.sanctions.map((s) => (
                      <li style="display:flex; align-items:flex-start; gap:0.5rem; font-size:0.75rem; color:#475569; line-height:1.5;">
                        <span style="color:#F5C842; font-weight:700; flex-shrink:0;">•</span>
                        <span>{s}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Bagian C: Sanksi Pelanggaran Khusus -->
        <div class="bg-white rounded-card-lg border-2 border-cokro-navy p-6 sm:p-8 shadow-3d-solid">
          <div class="mb-6">
            <h2 class="sect-heading">
              <span class="badge-letter badge-letter-red">C</span>
              Sanksi Pelanggaran Khusus
            </h2>
            <p class="font-body text-xs text-cokro-text-muted mt-1">
              Tindakan langsung / penanganan khusus di tempat untuk jenis pelanggaran tertentu
            </p>
          </div>

          <div style="overflow-x:auto; border:2px solid #0A2540; border-radius:0.75rem;">
            <table class="tt-table" style="width:100%; min-width:500px;">
              <thead>
                <tr>
                  <th class="col-no col-gold-header">NO</th>
                  <th class="col-gold-header" style="width:48%">PELANGGARAN KHUSUS</th>
                  <th class="col-gold-header" style="width:48%">TINDAKAN / SANKSI KHUSUS</th>
                </tr>
              </thead>
              <tbody>
                {
                  SPECIAL_SANCTIONS.map((item) => (
