---
// Introduction.astro — Revised: compact mobile cards, cleaner layout
import "swiper/css";
import "swiper/css/pagination";
import "swiper/css/navigation";
import { Image } from 'astro:assets';
import tmtpKp from '../../assets/photos/gallery/tmtp-kp.webp';
import tmtpGk from '../../assets/photos/gallery/tmtp-gk.webp';
---
<section class="py-20 px-4 sm:px-6 lg:px-8 bg-transparent relative" aria-labelledby="intro-title">
  <!-- Top wave divider -->
  <div class="absolute top-0 left-0 w-full overflow-hidden leading-none z-10 rotate-180 pointer-events-none">
    <svg class="relative block w-full h-[30px] md:h-[60px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
      <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V120H0V95.8C59.71,118.08,130.83,115.3,188.71,98.67,234.33,85.53,278.4,70.28,321.39,56.44Z" class="fill-white"></path>
    </svg>
  </div>

  <div class="max-w-7xl mx-auto pt-8">

    <!-- Part 1: Pendahuluan split layout -->
    <div class="flex flex-col lg:flex-row items-center gap-10 mb-16">
      <div class="w-full lg:w-1/2">
        <span class="inline-block mb-3 px-3 py-1 bg-cokro-gold text-cokro-navy font-display font-extrabold text-xs rounded-pill shadow-3d-solid uppercase tracking-widest">PKKMB FV UNY 2026</span>
        <h2 id="intro-title" class="font-display font-bold text-3xl md:text-5xl text-cokro-navy mb-4">Pendahuluan</h2>
        <div class="w-14 h-2 bg-cokro-gold rounded-pill mb-6"></div>
        <div class="font-body text-base md:text-lg text-cokro-text-muted leading-relaxed space-y-4">
          <p>
            PKKMB Fakultas Vokasi merupakan kegiatan pengenalan kampus yang bertujuan untuk membantu mahasiswa baru dalam mengenal lingkungan perkuliahan, budaya akademik, serta kehidupan organisasi di Fakultas Vokasi.
          </p>
          <p>
            Kegiatan ini menjadi langkah awal bagi mahasiswa baru untuk membangun relasi, mengembangkan potensi diri, serta mempersiapkan diri menghadapi dunia perkuliahan yang penuh peluang.
          </p>
        </div>
      </div>
      <div class="w-full lg:w-1/2">
        <!-- Swiper Slider TMTP -->
        <div class="relative rounded-card-lg border-4 border-cokro-navy shadow-3d-solid-lg overflow-hidden bg-cokro-navy">
          <div class="swiper intro-tmtp-slider w-full h-56 sm:h-64 lg:h-72">
            <div class="swiper-wrapper">
              <!-- Slide 1: TMTP Kulon Progo -->
              <div class="swiper-slide relative cursor-grab active:cursor-grabbing">
                <Image
                  src={tmtpKp}
                  alt="TMTP PKKMB KM FV UNY 2025 — Kampus Kulon Progo"
                  class="w-full h-full object-cover select-none pointer-events-none"
                  loading="lazy"
                  decoding="async"
                  width={600}
                  height={350}
                />
                <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-cokro-navy/90 to-transparent px-4 py-3">
                  <p class="text-white text-xs font-display font-bold uppercase tracking-widest">📍 TMTP · Kampus Kulon Progo</p>
                </div>
              </div>
              <!-- Slide 2: TMTP Gunungkidul -->
              <div class="swiper-slide relative cursor-grab active:cursor-grabbing">
                <Image
                  src={tmtpGk}
                  alt="TMTP PKKMB KM FV UNY 2025 — Kampus Gunungkidul"
                  class="w-full h-full object-cover select-none pointer-events-none"
                  loading="lazy"
                  decoding="async"
                  width={600}
                  height={350}
                />
                <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-cokro-navy/90 to-transparent px-4 py-3">
                  <p class="text-white text-xs font-display font-bold uppercase tracking-widest">📍 TMTP · Kampus Gunungkidul</p>
                </div>
              </div>
            </div>
            <!-- Pagination dots -->
            <div class="intro-tmtp-pagination swiper-pagination"></div>
            <!-- Navigation arrows -->
            <div class="intro-tmtp-prev swiper-button-prev !text-white !drop-shadow-md"></div>
            <div class="intro-tmtp-next swiper-button-next !text-white !drop-shadow-md"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Part 2: Visi, Misi, Tujuan — COMPACT horizontal on mobile -->
    <!-- Mobile: horizontal scroll cards. Desktop: 3-column grid -->
    <div>
      <h3 class="font-display font-bold text-xl md:text-2xl text-cokro-navy mb-5 text-center">Visi, Misi & Tujuan</h3>

      <!-- Mobile: horizontal snap scroll -->
      <div class="flex md:hidden gap-4 overflow-x-auto pb-4 snap-x snap-mandatory scrollbar-hide -mx-4 px-4">
        
        <!-- Visi -->
        <div class="snap-start shrink-0 w-[75vw] max-w-[280px] bg-white p-5 rounded-card-md border-2 border-cokro-navy shadow-3d-solid flex flex-col">
          <div class="w-10 h-10 rounded-full bg-cokro-blue border-2 border-cokro-navy flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.9 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
          </div>
          <h3 class="font-display font-bold text-lg text-cokro-navy mb-2">Visi</h3>
          <p class="font-body text-sm text-cokro-text-muted leading-relaxed">Terwujudnya Mahasiswa Baru yang berpikiran terbuka, kreatif dan adaptif sehingga mampu menerapkan di berbagai lingkungan.</p>
        </div>

        <!-- Misi -->
        <div class="snap-start shrink-0 w-[75vw] max-w-[280px] bg-white p-5 rounded-card-md border-2 border-cokro-navy shadow-3d-solid flex flex-col">
          <div class="w-10 h-10 rounded-full bg-cokro-gold border-2 border-cokro-navy flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0A2540" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg>
          </div>
          <h3 class="font-display font-bold text-lg text-cokro-navy mb-2">Misi</h3>
          <ol class="font-body text-sm text-cokro-text-muted leading-relaxed space-y-1.5 list-decimal list-outside ml-4">
            <li>Menerapkan sistem 5 S (salam, sapa, senyum, sopan dan santun).</li>
            <li>Menyampaikan informasi secara jelas agar mahasiswa baru mampu beradaptasi.</li>
            <li>Memberikan ruang yang mendukung untuk aktif, kreatif dan percaya diri.</li>
          </ol>
        </div>

        <!-- Tujuan -->
        <div class="snap-start shrink-0 w-[75vw] max-w-[280px] bg-white p-5 rounded-card-md border-2 border-cokro-navy shadow-3d-solid flex flex-col">
          <div class="w-10 h-10 rounded-full bg-cokro-sky border-2 border-cokro-navy flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
          </div>
          <h3 class="font-display font-bold text-lg text-cokro-navy mb-2">Tujuan</h3>
          <p class="font-body text-sm text-cokro-text-muted leading-relaxed">Menjadi wadah mahasiswa baru mengenal kampus, membangun karakter 5S, serta mengembangkan sikap aktif, kreatif, percaya diri, dan adaptif.</p>
        </div>
      </div>

      <!-- Desktop: 3-column grid (same content) -->
      <div class="hidden md:grid grid-cols-3 gap-6">
        <!-- Visi -->
        <div class="bg-white p-7 rounded-card-md border-2 border-cokro-navy shadow-3d-solid hover:-translate-y-2 hover:shadow-3d-solid-hover transition-all duration-300 flex flex-col">
          <div class="w-14 h-14 rounded-full bg-cokro-blue border-2 border-cokro-navy flex items-center justify-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.9 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
          </div>
          <h3 class="font-display font-bold text-2xl text-cokro-navy mb-3">Visi</h3>
          <p class="font-body text-cokro-text-muted leading-relaxed">Terwujudnya Mahasiswa Baru yang berpikiran terbuka, kreatif dan adaptif sehingga mampu menerapkan di berbagai lingkungan.</p>
        </div>
        <!-- Misi -->
        <div class="bg-white p-7 rounded-card-md border-2 border-cokro-navy shadow-3d-solid hover:-translate-y-2 hover:shadow-3d-solid-hover transition-all duration-300 flex flex-col">
          <div class="w-14 h-14 rounded-full bg-cokro-gold border-2 border-cokro-navy flex items-center justify-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0A2540" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg>
          </div>
          <h3 class="font-display font-bold text-2xl text-cokro-navy mb-3">Misi</h3>
          <ol class="font-body text-cokro-text-muted leading-relaxed space-y-2 list-decimal list-outside ml-4">
            <li>Menerapkan sistem 5 S (salam, sapa, senyum, sopan dan santun).</li>
            <li>Menyampaikan informasi secara jelas agar mahasiswa baru mampu beradaptasi.</li>
            <li>Memberikan ruang yang mendukung untuk aktif, kreatif dan percaya diri.</li>
          </ol>
        </div>
        <!-- Tujuan -->
        <div class="bg-white p-7 rounded-card-md border-2 border-cokro-navy shadow-3d-solid hover:-translate-y-2 hover:shadow-3d-solid-hover transition-all duration-300 flex flex-col">
          <div class="w-14 h-14 rounded-full bg-cokro-sky border-2 border-cokro-navy flex items-center justify-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
          </div>
          <h3 class="font-display font-bold text-2xl text-cokro-navy mb-3">Tujuan</h3>
          <p class="font-body text-cokro-text-muted leading-relaxed">Menjadi wadah mahasiswa baru mengenal kampus, membangun karakter 5S, serta mengembangkan sikap aktif, kreatif, percaya diri, dan adaptif.</p>
        </div>
      </div>

      <!-- Mobile scroll hint -->
      <p class="md:hidden text-center text-xs text-cokro-text-muted mt-3 font-body">← Scroll untuk lihat semua →</p>
    </div>

  </div>
</section>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
  import Swiper from "swiper";
  import { Navigation, Pagination, Autoplay } from "swiper/modules";

  function initIntroSlider() {
    const sliderEl = document.querySelector(".intro-tmtp-slider");
    if (sliderEl) {
      new Swiper(".intro-tmtp-slider", {
        modules: [Navigation, Pagination, Autoplay],
        loop: true,
        slidesPerView: 1,
        spaceBetween: 0,
        grabCursor: true,
        simulateTouch: true,
        allowTouchMove: true,
        pagination: {
          el: ".intro-tmtp-pagination",
          clickable: true,
        },
        navigation: {
          nextEl: ".intro-tmtp-next",
          prevEl: ".intro-tmtp-prev",
        },
        autoplay: {
          delay: 4000,
          disableOnInteraction: false,
        },
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initIntroSlider);
  } else {
    initIntroSlider();
  }
  document.addEventListener("astro:page-load", initIntroSlider);
</script>
