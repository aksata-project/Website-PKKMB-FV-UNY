---
// src/pages/ukm/[id].astro — Dynamic detail page for each UKM
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { orgs, getOrgById } from '../../data/orgs';

export async function getStaticPaths() {
  return orgs
    .filter(o => o.type === 'ukm')
    .map(o => ({ params: { id: o.id } }));
}

const { id } = Astro.params;
const org = getOrgById(id as string);

if (!org) {
  return Astro.redirect('/ukm');
}

const badgeColorMap: Record<string, string> = {
  gold: 'bg-cokro-gold text-cokro-navy',
  blue: 'bg-cokro-blue text-white',
  sky:  'bg-cokro-sky text-white',
};
---

<BaseLayout
  title={`${org.name} — PKKMB FV UNY 2026`}
  description={`Profil ${org.name} (${org.shortName}) — Unit Kegiatan Mahasiswa Fakultas Vokasi UNY.`}
  preloadImages={org.headerImage ? [org.headerImage] : []}
>
  <Navbar />

    <PageHeader
      title={org.name}
      subtitle={org.shortName}
      badge={org.badge}
      headerImage={org.headerImage}
    />

    <main class="py-14 md:py-20 px-4 sm:px-6 lg:px-8">
      <div class="max-w-6xl mx-auto space-y-16">

        <!-- Back Button -->
        <a href="/ukm" class="inline-flex items-center gap-2 text-sm font-bold text-cokro-blue hover:text-cokro-navy transition-colors group">
          <span class="w-7 h-7 rounded-full bg-white border-2 border-cokro-navy shadow-3d-solid flex items-center justify-center group-hover:bg-cokro-gold transition-colors">←</span>
          Kembali ke Daftar UKM
        </a>

        <!-- A: Nama & Logo -->
        <section class="relative overflow-hidden bg-white rounded-card-lg border-2 border-cokro-navy shadow-3d-solid-lg p-7 md:p-10 grid md:grid-cols-[auto_1fr] items-center gap-7 md:gap-10">
          <div class="absolute -right-16 -top-16 w-52 h-52 rounded-full border-[18px] border-cokro-gold/25 pointer-events-none"></div>
          <div class="relative w-32 h-32 md:w-40 md:h-40 shrink-0 rounded-full bg-cokro-tint border-4 border-cokro-navy shadow-3d-solid flex items-center justify-center">
            <img src={org.logo} alt={`Logo ${org.name}`} class="w-24 h-24 md:w-28 md:h-28 object-contain" loading="lazy" decoding="async" />
          </div>
          <div class="relative">
            <span class={`inline-block mb-2 px-4 py-1 rounded-pill text-xs font-extrabold uppercase tracking-widest border-2 border-cokro-navy ${badgeColorMap[org.badgeColor]}`}>{org.badge}</span>
            <h2 class="font-display font-black text-3xl md:text-4xl text-cokro-navy leading-tight mb-1">{org.name}</h2>
            <p class="font-body font-bold text-cokro-sky uppercase tracking-widest text-sm">{org.shortName}</p>
          </div>
        </section>

        <!-- Gallery Photos Section (3 Photos) -->
        <section aria-labelledby="gallery-title">
          <div class="flex items-end justify-between gap-4 mb-6 border-b-2 border-cokro-navy pb-3">
            <h3 id="gallery-title" class="font-display font-bold text-2xl md:text-3xl text-cokro-navy">Galeri & Dokumentasi</h3>
            <span class="font-display font-black text-cokro-blue text-sm tracking-widest">01</span>
          </div>
          {org.gallery && org.gallery.length > 0 ? (
            <div class="gallery-carousel flex gap-5 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-2">
              {org.gallery.slice(0, 3).map((imgUrl, idx) => (
                <div class="group relative w-full flex-none snap-start rounded-card-md border-2 border-cokro-navy shadow-3d-solid overflow-hidden bg-cokro-navy aspect-[4/3] md:aspect-[16/9]">
                  <img
                    src={imgUrl}
                    alt={`Dokumentasi ${org.name} #${idx + 1}`}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-cokro-navy/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
                    <span class="text-xs font-bold text-white uppercase tracking-wider">Dokumentasi {String(idx + 1).padStart(2, '0')}</span>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="bg-white rounded-card-md border-2 border-dashed border-cokro-navy/30 p-8 text-center flex flex-col items-center justify-center">
              <div class="w-12 h-12 rounded-full bg-cokro-tint border-2 border-cokro-navy flex items-center justify-center mb-3">
                <svg class="w-6 h-6 text-cokro-navy" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <p class="font-display font-bold text-cokro-navy text-base mb-1">Dokumentasi Belum Tersedia</p>
              <p class="font-body text-xs text-cokro-text-muted max-w-sm">Foto dokumentasi kegiatan resmi untuk {org.shortName} belum diunggah oleh pengurus organisasi.</p>
            </div>
          )}
        </section>

        <!-- D: Deskripsi -->
        <section aria-labelledby="desc-title">
          <div class="flex items-end justify-between gap-4 mb-5 border-b-2 border-cokro-navy pb-3">
            <h3 id="desc-title" class="font-display font-bold text-2xl text-cokro-navy">Deskripsi</h3><span class="font-display font-black text-cokro-blue text-sm tracking-widest">02</span>
          </div>
          <div class="bg-white rounded-card-md border-2 border-cokro-navy shadow-3d-solid p-6">
            <p class="font-body text-cokro-text-muted leading-relaxed">{org.description}</p>
          </div>
        </section>

        <!-- B: Visi & Misi -->
        <section aria-labelledby="vismis-title">
          <div class="flex items-end justify-between gap-4 mb-5 border-b-2 border-cokro-navy pb-3">
            <h3 id="vismis-title" class="font-display font-bold text-2xl text-cokro-navy">Visi & Misi</h3><span class="font-display font-black text-cokro-blue text-sm tracking-widest">03</span>
          </div>
          <div class="grid md:grid-cols-2 gap-6">
            <div class="bg-white rounded-card-md border-2 border-cokro-navy shadow-3d-solid p-6">
              <h4 class="font-display font-bold text-cokro-blue text-lg mb-3 flex items-center gap-2">
                <span class="w-6 h-6 rounded-full bg-cokro-blue text-white text-xs flex items-center justify-center font-black">V</span>
                Visi
              </h4>
              <p class="font-body text-cokro-text-muted leading-relaxed italic">"{org.vision}"</p>
            </div>
            <div class="bg-white rounded-card-md border-2 border-cokro-navy shadow-3d-solid p-6">
              <h4 class="font-display font-bold text-cokro-blue text-lg mb-3 flex items-center gap-2">
                <span class="w-6 h-6 rounded-full bg-cokro-blue text-white text-xs flex items-center justify-center font-black">M</span>
                Misi
              </h4>
              <ul class="space-y-2">
                {org.missions.map((m, i) => (
                  <li class="flex gap-3 font-body text-sm text-cokro-text-muted">
                    <span class="shrink-0 w-6 h-6 rounded-full bg-cokro-gold border border-cokro-navy flex items-center justify-center font-black text-xs text-cokro-navy mt-0.5">{i+1}</span>
                    <span>{m}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>

        <!-- C: Struktur Organisasi -->
        <section aria-labelledby="struct-title">
          <div class="flex items-end justify-between gap-4 mb-5 border-b-2 border-cokro-navy pb-3">
            <h3 id="struct-title" class="font-display font-bold text-2xl text-cokro-navy">Struktur Organisasi</h3><span class="font-display font-black text-cokro-blue text-sm tracking-widest">04</span>
          </div>
          <div class="bg-white rounded-card-md border-2 border-cokro-navy shadow-3d-solid p-6">
            <div class="grid sm:grid-cols-3 gap-4 mb-6">
              {[
                { label: 'Pembina', value: org.structure.pembina, color: 'bg-cokro-navy text-white' },
                { label: 'Ketua', value: org.structure.ketua, color: 'bg-cokro-gold text-cokro-navy' },
                { label: 'Wakil Ketua', value: org.structure.wakilKetua, color: 'bg-cokro-blue text-white' },
              ].map(item => (
                <div class={`rounded-xl p-4 text-center border-2 border-cokro-navy shadow-3d-solid ${item.color}`}>
                  <p class="text-xs font-extrabold uppercase tracking-wider opacity-75 mb-1">{item.label}</p>
                  <p class="font-display font-bold text-sm leading-snug">{item.value}</p>
                </div>
              ))}
            </div>
            <h4 class="font-display font-bold text-cokro-blue text-base mb-3">Divisi / Bidang</h4>
            <div class="grid sm:grid-cols-2 gap-3">
              {org.structure.divisions.map(div => (
                <div class="flex items-start gap-3 p-3 bg-cokro-tint rounded-xl border border-cokro-navy/20">
                  <span class="w-2 h-2 rounded-full bg-cokro-gold border border-cokro-navy shrink-0 mt-2"></span>
                  <div>
                    <p class="font-display font-bold text-sm text-cokro-navy">{div.name}</p>
                    <p class="font-body text-xs text-cokro-text-muted">{div.head}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- E: Program Kerja Unggulan -->
        <section aria-labelledby="proker-title">
          <div class="flex items-end justify-between gap-4 mb-5 border-b-2 border-cokro-navy pb-3">
            <h3 id="proker-title" class="font-display font-bold text-2xl text-cokro-navy">Program Kerja Unggulan</h3><span class="font-display font-black text-cokro-blue text-sm tracking-widest">05</span>
          </div>
          <div class="grid sm:grid-cols-2 gap-5">
            {org.programs.map((p, i) => (
              <div class="bg-white rounded-card-md border-2 border-cokro-navy shadow-3d-solid hover:-translate-y-1 hover:shadow-3d-solid-hover transition-all duration-200 p-5 flex gap-4">
                <span class="shrink-0 w-10 h-10 rounded-full bg-cokro-tint border-2 border-cokro-navy flex items-center justify-center font-display font-black text-cokro-navy text-sm">{i+1}</span>
                <div>
                  <h4 class="font-display font-bold text-cokro-navy mb-1">{p.name}</h4>
                  <p class="font-body text-sm text-cokro-text-muted leading-relaxed">{p.description}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- F: Prestasi (Opsional) -->
        {org.achievements && org.achievements.length > 0 && (
          <section aria-labelledby="prestasi-title">
            <div class="flex items-end justify-between gap-4 mb-5 border-b-2 border-cokro-navy pb-3">
              <h3 id="prestasi-title" class="font-display font-bold text-2xl text-cokro-navy">Prestasi</h3><span class="font-display font-black text-cokro-blue text-sm tracking-widest">06</span>
            </div>
            <div class="bg-white rounded-card-md border-2 border-cokro-navy shadow-3d-solid p-6 space-y-3">
              {org.achievements.map(a => (
                <div class="flex items-start gap-3">
                  <span class="shrink-0 w-6 h-6 rounded-full bg-cokro-gold border border-cokro-navy flex items-center justify-center font-black text-xs">{String(org.achievements.indexOf(a) + 1).padStart(2, '0')}</span>
                  <p class="font-body text-cokro-text-muted leading-relaxed">{a}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- G: Kontak & Media Sosial -->
        <section aria-labelledby="kontak-title">
          <div class="flex items-end justify-between gap-4 mb-5 border-b-2 border-cokro-navy pb-3">
            <h3 id="kontak-title" class="font-display font-bold text-2xl text-cokro-navy">Kontak & Media Sosial</h3><span class="font-display font-black text-cokro-blue text-sm tracking-widest">07</span>
          </div>
          <div class="flex flex-wrap gap-4">
            {org.contact.instagram && (
              <a href={org.contact.instagram} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-3 px-6 py-3 rounded-pill border-2 border-cokro-navy shadow-3d-solid hover:-translate-y-1 hover:shadow-3d-solid-hover transition-all duration-200 bg-gradient-to-r from-purple-500 to-pink-500 text-white font-display font-bold">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                Instagram
              </a>
            )}
          </div>
        </section>

      </div>
    </main>

    <Footer />
    <style>
      .gallery-carousel::-webkit-scrollbar {
        display: none;
      }

      .gallery-carousel {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
</BaseLayout>
