---
// src/pages/panduan.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import PageHeader from '../components/ui/PageHeader.astro';

const documentResources = [
  {
    title: 'Tata Tertib Peserta',
    description: 'Dokumen resmi aturan & ketentuan selama PKKMB KM FV UNY 2026 (bermaterai & disahkan).',
    icon: '⚖️',
    color: 'bg-cokro-gold text-cokro-navy',
    driveHref: 'https://drive.google.com/file/d/1Wi4R7x-wwwzy-8xf1BeTsyZvcOBh-O8a/view' as string | null,
    pageHref: '/tata-tertib' as string | null,
  },
  {
    title: 'Ketentuan Atribut Maba',
    description: 'Ketentuan pakaian, dresscode, dan perlengkapan peserta PKKMB 2026.',
    icon: '👔',
    color: 'bg-cokro-blue text-white',
    driveHref: 'https://drive.google.com/file/d/167-30-nBzNGJX_CDwnVZckG6pnxg0oDy/view' as string | null,
    pageHref: '/ketentuan-atribut' as string | null,
  },
  {
    title: 'Pemaparan Advokasi',
    description: 'Materi layanan advokasi dan kanal bantuan mahasiswa baru selama PKKMB.',
    icon: '🫱🏻‍🫲🏽',
    color: 'bg-red-500 text-white',
    driveHref: 'https://drive.google.com/file/d/1efcmBjmekfIj-naUmBrzZ4Wvz3m7CE4p/view' as string | null,
    pageHref: '/advokasi' as string | null,
  },
  {
    title: 'Materi Pembekalan (CAnVas)',
    description: 'Slide materi ALL DREAMS & CAnVas untuk TMTP PKKMB FV UNY 2026.',
    icon: '📘',
    color: 'bg-purple-600 text-white',
    driveHref: 'https://drive.google.com/file/d/1mJEs2l9NAwdnrlkkWwUq-hf85xd_NBPA/view' as string | null,
    pageHref: '/canvas' as string | null,
  },
];
---

<BaseLayout
  title="Panduan PKKMB FV UNY 2026 — Cokro Aksata"
  description="Panduan registrasi, tata tertib, dan dresscode PKKMB Fakultas Vokasi UNY 2026."
>
  <Navbar />

    <PageHeader
      title="Panduan PKKMB"
      subtitle="Semua informasi yang kamu butuhkan — dari cara daftar hingga apa yang harus dipakai. Baca dengan seksama, ya!"
      badge="Panduan Peserta"
    />

    <main class="py-20 px-4 sm:px-6 lg:px-8">
      <div class="max-w-6xl mx-auto space-y-24">

        <!-- Pusat dokumen dan informasi peserta -->
        <section aria-labelledby="resources-title" class="relative overflow-hidden rounded-card-lg border-4 border-cokro-navy bg-white p-6 shadow-3d-solid-lg sm:p-8">
          <div class="absolute -right-16 -top-16 h-48 w-48 rounded-full bg-cokro-gold/20 blur-3xl"></div>
          <div class="relative">
            <div class="mb-8 flex flex-col gap-3 text-center sm:text-left">
              <span class="w-fit self-center rounded-pill border-2 border-cokro-navy bg-cokro-gold px-4 py-1.5 font-display text-xs font-black text-cokro-navy shadow-3d-solid sm:self-start">PUSAT INFORMASI</span>
              <div>
                <h2 id="resources-title" class="font-display text-3xl font-black text-cokro-navy sm:text-4xl">Dokumen Peserta</h2>
                <p class="mt-2 max-w-2xl font-body text-sm leading-relaxed text-cokro-text-muted">Simpan empat dokumen ini sebelum kegiatan dimulai. Google Drive resmi adalah sumber kebenaran utama.</p>
              </div>
            </div>

            <!-- Grid 4 Dokumen Peserta -->
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
              {documentResources.map((resource) => (
                <article class="relative flex flex-col justify-between overflow-hidden rounded-card-md border-2 border-cokro-navy bg-white p-5 shadow-3d-solid">
                  <div>
                    <div class={`mb-5 flex h-14 w-14 items-center justify-center rounded-xl border-2 border-cokro-navy text-3xl shadow-[3px_3px_0_#0A2540] ${resource.color}`}>
                      {resource.icon}
                    </div>
                    <h3 class="font-display text-xl font-black text-cokro-navy">{resource.title}</h3>
                    <p class="mt-2 font-body text-sm leading-relaxed text-cokro-text-muted">{resource.description}</p>
                  </div>

                  <div class="mt-5 flex flex-col gap-2.5">
                    {resource.driveHref ? (
                      <a
                        href={resource.driveHref}
                        target="_blank"
                        rel="noreferrer"
                        class="inline-flex items-center justify-center rounded-pill border-2 border-cokro-navy bg-cokro-blue px-4 py-2 font-display text-xs font-black text-white shadow-3d-solid transition-all hover:-translate-y-0.5 hover:shadow-3d-solid-hover"
                      >
                        Buka Google Drive ↗
                      </a>
                    ) : (
                      <span aria-disabled="true" class="inline-flex items-center justify-center rounded-pill border-2 border-cokro-navy bg-cokro-tint px-4 py-2 font-display text-xs font-black text-cokro-text-muted">
                        LINK MENYUSUL
                      </span>
                    )}

                    {resource.pageHref && (
                      <a
                        href={resource.pageHref}
                        class="inline-flex items-center justify-center rounded-pill border-2 border-cokro-navy bg-cokro-gold px-4 py-2 font-display text-xs font-black text-cokro-navy shadow-3d-solid transition-all hover:-translate-y-0.5 hover:shadow-3d-solid-hover"
                      >
                        Buka Halaman 📋
                      </a>
                    )}
                  </div>
                </article>
              ))}
            </div>

          </div>
        </section>

      </div>
    </main>

    <Footer />
</BaseLayout>

