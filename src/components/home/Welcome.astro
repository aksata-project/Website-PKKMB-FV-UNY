---
// Welcome.astro — Revised: YouTube direct embed, Swiper full controls & drag, Mascot animation
import "swiper/css";
import "swiper/css/pagination";
import "swiper/css/navigation";
import "swiper/css/autoplay";

// 10 gallery images (PKKMB 2025)
const galleryImages = [
  {
    src: "/Assets/photos/gallery/pkkmb-gallery-1.webp",
    alt: "Dokumentasi Kegiatan PKKMB Kampus Wates (Kulon Progo) #1",
  },
  {
    src: "/Assets/photos/gallery/pkkmb-gallery-2.webp",
    alt: "Keseruan Rangkaian Acara Kampus Wates (Kulon Progo) #2",
  },
  {
    src: "/Assets/photos/gallery/pkkmb-gallery-3.webp",
    alt: "Sesi TMTP Mahasiswa Baru Kampus Wates (Kulon Progo) #3",
  },
  {
    src: "/Assets/photos/gallery/pkkmb-gallery-4.webp",
    alt: "Antusiasme Peserta PKKMB Kampus Wates (Kulon Progo) #4",
  },
  {
    src: "/Assets/photos/gallery/pkkmb-gallery-5.webp",
    alt: "Kebersamaan Vokasi Muda Kampus Wates (Kulon Progo) #5",
  },
  {
    src: "/Assets/photos/gallery/pkkmb-gallery-6.webp",
    alt: "Dokumentasi Kegiatan PKKMB Kampus Gunungkidul #6",
  },
  {
    src: "/Assets/photos/gallery/pkkmb-gallery-7.webp",
    alt: "Suasana Acara Terpadu Kampus Gunungkidul #7",
  },
  {
    src: "/Assets/photos/gallery/pkkmb-gallery-8.webp",
    alt: "Antusiasme Mahasiswa Baru Kampus Gunungkidul #8",
  },
  {
    src: "/Assets/photos/gallery/pkkmb-gallery-9.webp",
    alt: "Sesi Kepemanduan Kampus Gunungkidul #9",
  },
  {
    src: "/Assets/photos/gallery/pkkmb-gallery-10.webp",
    alt: "Momen Spesial PKKMB Kampus Gunungkidul #10",
  },
];
---

<section
  id="welcome"
  class="relative overflow-hidden bg-white px-4 py-24 sm:px-6 lg:px-8"
  aria-labelledby="welcome-title"
>
  <!-- Mixed decorative background -->
  <div class="absolute inset-0 bg-doodle-pattern opacity-[0.08] pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -left-20 top-20 h-56 w-56 rounded-full bg-cokro-gold/20 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -right-24 top-1/3 h-72 w-72 rounded-full bg-cokro-sky/20 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute right-[8%] top-24 hidden h-24 w-24 rounded-full border-4 border-cokro-blue/20 sm:block" aria-hidden="true"></div>
  <div class="absolute left-[8%] top-48 hidden text-4xl text-cokro-gold/70 sm:block" aria-hidden="true">✦</div>
  <div class="absolute right-[12%] bottom-32 hidden text-3xl text-cokro-blue/40 sm:block" aria-hidden="true">✦</div>

  <!-- LARGE PEEKING MASCOT FROM RIGHT SIDE EDGE (Head & Upper Body Only) -->
  <!-- Mobile: z-0 (behind text), opacity 40%, pushed further right (-right-24). Desktop: z-30, full opacity -->
  <div
    id="mascot-peeking-container"
    class="pointer-events-none absolute -right-24 top-4 sm:-right-28 sm:top-2 md:-right-36 md:top-4 lg:-right-48 lg:top-6 xl:-right-56 z-0 sm:z-30 opacity-40 sm:opacity-100 w-52 sm:w-96 md:w-[480px] lg:w-[580px] xl:w-[640px]"
    aria-hidden="true"
  >
    <div class="mascot-tilt-wrapper transition-transform duration-700 ease-out">
      <img
        src="/Assets/images/maskot-fv.webp"
        alt="Maskot Fakultas Vokasi UNY"
        class="w-full h-auto object-contain drop-shadow-[0_20px_35px_rgba(10,37,64,0.35)]"
        loading="lazy"
      />
    </div>
  </div>

  <div class="relative z-10 mx-auto max-w-5xl">
    <!-- Section heading -->
    <div class="relative text-center mb-12">
      <span
        class="inline-block px-4 py-1.5 bg-cokro-gold text-cokro-navy font-display font-extrabold text-sm rounded-pill shadow-3d-solid mb-4 uppercase tracking-widest"
        >SELAMAT DATANG</span
      >
      <h2
        id="welcome-title"
        class="font-display font-bold text-4xl md:text-5xl text-cokro-navy mb-4 relative z-10"
      >
        HALO VOKASI MUDA !!
      </h2>
      <p
        class="font-body text-lg text-cokro-text-muted max-w-2xl mx-auto leading-relaxed relative z-10"
      >
        Selamat datang di keluarga besar Fakultas Vokasi Universitas Negeri
        Yogyakarta!<br />
      </p>
      <svg class="mx-auto mt-5 h-7 w-36 text-cokro-blue" viewBox="0 0 144 28" fill="none" aria-hidden="true">
        <path d="M4 14c14-18 24 18 38 0s24 18 38 0 24 18 38 0 14 6 22 0" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
      </svg>
    </div>

    <!-- ─── YouTube Embed — Center, Highlighted ─── -->
    <div class="mb-14">
      <!-- Highlighted title -->
      <div class="flex items-center justify-center gap-4 mb-6">
        <div class="flex-1 max-w-[80px] h-1 bg-cokro-gold rounded-full"></div>
        <h3
          class="font-display font-black text-2xl md:text-3xl text-cokro-navy text-center"
        >
          Glimpse of PKKMB FV UNY 2025
        </h3>
        <div class="flex-1 max-w-[80px] h-1 bg-cokro-gold rounded-full"></div>
      </div>

      <!-- YouTube Direct Autoplay Iframe -->
      <div
        class="rounded-card-lg border-4 border-cokro-navy shadow-3d-solid-lg overflow-hidden bg-cokro-navy"
      >
        <!-- Gold accent bar top -->
        <div class="h-2 w-full bg-cokro-gold"></div>
        <div
          class="relative w-full overflow-hidden"
          style="padding-bottom: 56.25%; height: 0;"
        >
          <iframe
            src="https://www.youtube.com/embed/blRWOn1KXSE?autoplay=1&mute=1&loop=1&playlist=blRWOn1KXSE&rel=0"
            title="After Movie PKKMB FV UNY 2025"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            loading="eager"
            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;"
          ></iframe>
        </div>
      </div>
      <p
        class="mt-3 text-sm font-body text-cokro-text-muted text-center italic"
      >
        After Movie PKKMB FV UNY 2025
      </p>
    </div>

    <!-- ─── Photo Slider — Below YouTube ─── -->
    <div>
      <p
        class="text-center font-display font-bold text-lg text-cokro-navy mb-6"
      >
        Intip keseruan PKKMB FV UNY 2025
      </p>

      <!-- Swiper gallery -->
      <div
        class="relative rounded-card-lg border-2 border-cokro-navy shadow-3d-solid-lg overflow-hidden bg-cokro-tint"
      >
        <div
          class="swiper maba-slider w-full h-[220px] sm:h-[320px] md:h-[400px]"
        >
          <div class="swiper-wrapper">
            {
              galleryImages.map((img) => (
                <div class="swiper-slide w-full h-full cursor-grab active:cursor-grabbing">
                  <img
                    src={img.src}
                    alt={img.alt}
                    loading="lazy"
                    class="w-full h-full object-cover select-none pointer-events-none"
                  />
                </div>
              ))
            }
          </div>
          <!-- Pagination -->
          <div class="swiper-pagination"></div>
          <!-- Navigation -->
          <div class="swiper-button-prev !text-white !drop-shadow-md"></div>
          <div class="swiper-button-next !text-white !drop-shadow-md"></div>
        </div>
      </div>
      <p class="mt-3 text-xs font-body text-cokro-text-muted text-center">
        Scroll foto → klik untuk diperbesar. Dokumentasi resmi PKKMB FV UNY.
      </p>
    </div>
  </div>
</section>

<script>
  import Swiper from "swiper";
  import { Navigation, Pagination, Autoplay } from "swiper/modules";

  function initWelcomeSlider() {
    // Intersection Observer for Mascot Entrance & Exit Re-trigger
    const mascotContainer = document.getElementById("mascot-peeking-container");
    const welcomeSection = document.getElementById("welcome");
    if (mascotContainer && welcomeSection) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              mascotContainer.classList.add("is-visible");
            } else {
              mascotContainer.classList.remove("is-visible");
            }
          });
        },
        { threshold: 0 }
      );
      observer.observe(welcomeSection);
      // Immediate check if already visible on load
      const rect = welcomeSection.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        mascotContainer.classList.add("is-visible");
      }
    }

    const sliderEl = document.querySelector(".maba-slider");
    if (sliderEl) {
      new Swiper(".maba-slider", {
        modules: [Navigation, Pagination, Autoplay],
        loop: true,
        slidesPerView: 1,
        spaceBetween: 0,
        grabCursor: true,
        simulateTouch: true,
        allowTouchMove: true,
        pagination: {
          el: ".swiper-pagination",
          clickable: true,
        },
        navigation: {
          nextEl: ".swiper-button-next",
          prevEl: ".swiper-button-prev",
        },
        autoplay: {
          delay: 3500,
          disableOnInteraction: false,
        },
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initWelcomeSlider);
  } else {
    initWelcomeSlider();
  }
  document.addEventListener("astro:page-load", initWelcomeSlider);
</script>

<style>
  /* Large Peeking Mascot Entrance from Right Screen Edge (Tilting Left -35deg) */
  .mascot-tilt-wrapper {
    transform: translateX(160px) translateY(-20px) rotate(-35deg) scale(0.85);
    opacity: 0;
  }

  #mascot-peeking-container.is-visible .mascot-tilt-wrapper {
    animation: mascot-pop-in 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
               mascot-sway-idle 4s ease-in-out infinite 1.2s;
  }

  @keyframes mascot-pop-in {
    0% {
      transform: translateX(180px) translateY(-30px) rotate(-45deg) scale(0.8);
      opacity: 0;
    }
    65% {
      transform: translateX(-15px) translateY(5px) rotate(-28deg) scale(1.04);
      opacity: 1;
    }
    85% {
      transform: translateX(8px) translateY(-2px) rotate(-37deg) scale(0.98);
    }
    100% {
      transform: translateX(0) translateY(0) rotate(-35deg) scale(1);
      opacity: 1;
    }
  }

  @keyframes mascot-sway-idle {
    0%, 100% {
      transform: translateX(0px) translateY(0px) rotate(-35deg);
    }
    50% {
      transform: translateX(-10px) translateY(-16px) rotate(-28deg);
    }
  }
</style>
