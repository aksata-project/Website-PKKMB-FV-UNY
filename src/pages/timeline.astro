---
// src/pages/timeline.astro
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import TimelineCard from '../components/timeline/TimelineCard.astro';

const milestones = [
  {
    date: '25 Juli 2026',
    title: 'TMTP',
    description: 'Technical Meeting Terpadu sebagai persiapan awal mahasiswa baru sebelum memasuki rangkaian kegiatan PKKMB.',
    
    status: 'upcoming' as const,
  },
  {
    date: '5 Agustus 2026',
    title: 'Kepemanduan 1',
    description: 'Sesi kepemanduan pertama untuk mengenal alur kegiatan, lingkungan kampus, dan persiapan peserta.',
    
    status: 'upcoming' as const,
  },
  {
    date: '10 Agustus 2026',
    title: 'Kepemanduan 2',
    description: 'Sesi kepemanduan lanjutan untuk memantapkan kesiapan seluruh peserta PKKMB.',
  
    status: 'upcoming' as const,
  },
  {
    date: '18–19 Agustus 2026',
    title: 'PKKMB UNY',
    description: 'Rangkaian Pengenalan Kehidupan Kampus bagi Mahasiswa Baru tingkat Universitas Negeri Yogyakarta.',

    status: 'upcoming' as const,
  },
  {
    date: '20 Agustus 2026',
    title: 'PKKMB FV UNY',
    description: 'Pengenalan Kehidupan Kampus bagi Mahasiswa Baru Fakultas Vokasi UNY.',
    status: 'upcoming' as const,
  },
  {
    date: '21 Agustus 2026',
    title: 'PKKMB Departemen',
    description: 'Pengenalan lingkungan, budaya akademik, dan organisasi di masing-masing departemen Fakultas Vokasi.',
    status: 'upcoming' as const,
  },
  {
    date: '29 Agustus 2026',
    title: 'SDP × OH',
    description: 'Student Development Program (SDP) bersama Open House Ormawa (OH) untuk mengenal ruang pengembangan diri dan organisasi mahasiswa.',
    status: 'upcoming' as const,
  },
];
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Timeline PKKMB FV UNY 2026 — Cokro Aksata</title>
    <meta name="description" content="Jadwal dan rangkaian kegiatan PKKMB Fakultas Vokasi Universitas Negeri Yogyakarta 2026." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400..700&family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..800&family=Sniglet:wght@400;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-cokro-tint text-cokro-navy font-body antialiased overflow-x-hidden selection:bg-cokro-gold selection:text-cokro-navy">
    <Navbar />

    <PageHeader
      title="Timeline PKKMB"
      subtitle="Jadwal lengkap rangkaian kegiatan PKKMB Fakultas Vokasi UNY 2026. Catat tanggal-tanggal penting dan bersiaplah untuk petualangan terbaikmu!"
      badge="PKKMB FV UNY 2026"
    />

    <main class="py-20 px-4 sm:px-6 lg:px-8">
      <div class="max-w-6xl mx-auto">
        <div class="relative mb-12 overflow-hidden rounded-card-lg border-4 border-cokro-navy bg-cokro-blue p-7 text-center shadow-3d-solid-lg sm:p-10">
          <div class="absolute -left-10 -top-10 h-32 w-32 rounded-full bg-cokro-gold/30 blur-2xl"></div>
          <div class="absolute -bottom-14 -right-8 h-40 w-40 rounded-full border-[18px] border-white/20"></div>
          <p class="relative mb-3 font-display text-sm font-black uppercase tracking-[0.25em] text-cokro-gold">Jadwal Utama</p>
          <h2 class="relative font-display font-black text-3xl text-white drop-shadow-[3px_3px_0_#0A2540] sm:text-5xl">PKKMB FV UNY 2026</h2>
          <p class="relative mx-auto mt-4 max-w-2xl font-body text-sm leading-relaxed text-white/90 sm:text-base">Simpan jadwal pentingmu. Setiap tile berisi tahap yang perlu kamu siapkan sebelum dan selama PKKMB.</p>
        </div>

        <!-- Instagram-feed inspired schedule grid -->
        <section aria-labelledby="schedule-title" class="relative rounded-card-lg border-4 border-cokro-navy bg-white p-3 shadow-3d-solid-lg sm:p-5">
          <div class="mb-5 flex flex-col items-center justify-between gap-3 px-2 sm:flex-row">
            <div>
              <p class="font-display text-sm font-black uppercase tracking-widest text-cokro-sky">Feed Jadwal</p>
              <h2 id="schedule-title" class="font-display text-2xl font-black text-cokro-navy sm:text-3xl">Rangkaian Kegiatan</h2>
            </div>
            <span class="rounded-pill border-2 border-cokro-navy bg-cokro-gold px-4 py-2 font-display text-xs font-black text-cokro-navy shadow-3d-solid">GESER & CATAT ✦</span>
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {milestones.map((m, i) => (
              <TimelineCard
                date={m.date}
                title={m.title}
                description={m.description}
                index={i}
              />
            ))}
          </div>
        </section>

        <!-- CTA -->
        <div class="mt-20 bg-white rounded-card-lg border-2 border-cokro-navy shadow-3d-solid-lg p-8 text-center">
          <h3 class="font-display font-black text-2xl text-cokro-navy mb-3">Siap untuk Petualangan?</h3>
          <p class="font-body text-cokro-text-muted mb-6 max-w-md mx-auto">Pastikan kamu sudah mendaftar dan mengikuti semua tahapan kegiatan. Sampai jumpa di PKKMB FV UNY 2026!</p>
          <a href="/panduan" class="inline-flex items-center gap-2 px-8 py-3 bg-cokro-blue text-white font-display font-bold rounded-pill border-2 border-cokro-navy shadow-3d-solid hover:-translate-y-1 hover:shadow-3d-solid-hover transition-all duration-200">
            Lihat Panduan Lengkap →
          </a>
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>
