---
interface Props {
  date: string;
  title: string;
  description: string;
  index: number;
}

const { date, title, description, index } = Astro.props;

const colorSets = [
  'bg-cokro-blue text-white',
  'bg-red-500 text-white',
  'bg-cokro-gold text-cokro-navy',
  'bg-cokro-sky text-white',
  'bg-white text-cokro-navy',
  'bg-cokro-navy text-white',
] as const;

const accents = [
  'bg-cokro-gold text-cokro-navy',
  'bg-white text-cokro-navy',
  'bg-cokro-blue text-white',
  'bg-cokro-gold text-cokro-navy',
  'bg-red-500 text-white',
  'bg-white text-cokro-navy',
] as const;

const cardColor = colorSets[index % colorSets.length];
const stickerColor = accents[index % accents.length];
const sticker = index < 3 ? 'PENTING!' : index === 3 ? 'TM' : index === 4 ? 'HARI-H' : index === 5 ? 'SERU!' : 'FINISH!';
---

<article class={`group relative min-h-[260px] overflow-hidden border-4 border-cokro-navy p-5 shadow-3d-solid transition-all duration-300 hover:-translate-y-2 hover:shadow-3d-solid-hover sm:min-h-[300px] ${cardColor}`}>
  <div class="absolute -bottom-9 -right-9 h-28 w-28 rounded-full border-[14px] border-current opacity-15"></div>
  <div class="absolute left-4 top-4 h-2 w-12 rounded-full bg-current opacity-30"></div>
  <span class={`absolute -right-2 top-4 rotate-12 rounded-full border-2 border-cokro-navy px-3 py-1 font-display text-xs font-black shadow-3d-solid ${stickerColor}`}>
    {sticker}
  </span>

  <div class="relative flex h-full flex-col pt-7">
    <div class="mb-4 flex items-end justify-between gap-3">
      <p class="font-display text-2xl font-black leading-none sm:text-3xl">{date}</p>
    </div>
    <div class="mt-auto border-t-2 border-current/30 pt-4">
      <h3 class="font-display text-xl font-black leading-tight">{title}</h3>
      <p class="mt-3 font-body text-xs leading-relaxed opacity-85 sm:text-sm">{description}</p>
    </div>
  </div>
</article>
