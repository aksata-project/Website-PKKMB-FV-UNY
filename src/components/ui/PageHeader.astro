---
// PageHeader.astro — Reusable banner header untuk semua halaman (Sizing diselaraskan)
interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
  headerImage?: string; // Opt: background image 1920x480 (banner ratio)
}
const { title, subtitle, badge, headerImage } = Astro.props;
---

<div class="relative">
  <section class="relative bg-cokro-header bg-doodle-pattern pt-28 pb-12 px-4 sm:px-6 lg:px-8 overflow-hidden min-h-[260px] md:min-h-[320px] flex items-center justify-center">
    <!-- Optional Background Image -->
    {headerImage && (
      <div class="absolute inset-0 z-0">
        <img 
          src={headerImage} 
          alt={`Header ${title}`}
          class="w-full h-full object-cover opacity-25"
          fetchpriority="high"
          decoding="async"
          onerror="this.onerror=null; this.src='https://placehold.co/1920x480/0F52BA/FFFFFF/webp?text=Header+Image+(1920+x+480)';"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-cokro-navy/60 via-cokro-header/70 to-cokro-header"></div>
      </div>
    )}

    <!-- Decorative blobs -->
    <div class="absolute top-8 right-12 w-32 h-32 bg-white/5 rounded-full blur-2xl pointer-events-none"></div>
    <div class="absolute bottom-4 left-16 w-48 h-48 bg-cokro-gold/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-4xl mx-auto text-center">
      {badge && (
        <span class="inline-block mb-3 px-4 py-1.5 bg-cokro-gold text-cokro-navy font-display font-extrabold text-xs sm:text-sm rounded-pill shadow-3d-solid uppercase tracking-widest">
          {badge}
        </span>
      )}
      <h1 class="font-display font-black text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-white mb-3 drop-shadow-[4px_4px_0_#0A2540] [-webkit-text-stroke:1px_#0A2540]">
        {title}
      </h1>
      {subtitle && (
        <p class="font-body text-base sm:text-lg md:text-xl text-white/90 max-w-2xl mx-auto leading-relaxed">
          {subtitle}
        </p>
      )}
    </div>
  </section>

  <!-- Wave Divider -->
  <div class="overflow-hidden bg-cokro-header leading-none">
    <svg class="block w-full h-[40px] md:h-[60px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
      <path d="M0,28 C150,75 300,74 450,36 C600,-2 750,8 900,48 C1035,84 1125,80 1200,34 V120 H0 Z" class="fill-cokro-tint"></path>
    </svg>
  </div>
</div>
