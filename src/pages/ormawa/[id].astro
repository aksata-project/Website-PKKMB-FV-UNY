---
// src/pages/ormawa/[id].astro — Dynamic detail page for each Ormawa
import '../../styles/global.css';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { orgs, getOrgById } from '../../data/orgs';

export async function getStaticPaths() {
  return orgs
    .filter(o => o.type === 'ormawa')
    .map(o => ({ params: { id: o.id } }));
}

const { id } = Astro.params;
const org = getOrgById(id as string);

if (!org) {
  return Astro.redirect('/ormawa');
}

const badgeColorMap: Record<string, string> = {
  gold: 'bg-cokro-gold text-cokro-navy',
  blue: 'bg-cokro-blue text-white',
  sky:  'bg-cokro-sky text-white',
};
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{org.name} — PKKMB FV UNY 2026</title>
    <meta name="description" content={`Profil ${org.name} (${org.shortName}) — Organisasi mahasiswa Fakultas Vokasi UNY.`} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400..700&family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..800&family=Sniglet:wght@400;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-cokro-tint text-cokro-navy font-body antialiased overflow-x-hidden selection:bg-cokro-gold selection:text-cokro-navy">
    <Navbar />

    <PageHeader
      title={org.name}
      subtitle={org.shortName}
      badge={org.badge}
      headerImage={org.headerImage}
    />

    <main class="py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-5xl mx-auto space-y-12">

        <!-- Back Button -->
        <a href="/ormawa" class="inline-flex items-center gap-2 text-sm font-bold text-cokro-blue hover:text-cokro-navy transition-colors group">
          <span class="w-7 h-7 rounded-full bg-white border-2 border-cokro-navy shadow-3d-solid flex items-center justify-center group-hover:bg-cokro-gold transition-colors">←</span>
          Kembali ke Daftar Ormawa
        </a>

        <!-- A: Nama & Logo -->
        <section class="bg-white rounded-card-lg border-2 border-cokro-navy shadow-3d-solid-lg p-8 flex flex-col sm:flex-row items-center gap-8">
          <div class="w-36 h-36 shrink-0 rounded-full bg-cokro-tint border-4 border-cokro-navy shadow-3d-solid flex items-center justify-center">
            <img src={org.logo} alt={`Logo ${org.name}`} class="w-24 h-24 object-contain" loading="lazy" />
          </div>
          <div>
            <span class={`inline-block mb-2 px-4 py-1 rounded-pill text-xs font-extrabold uppercase tracking-widest border-2 border-cokro-navy ${badgeColorMap[org.badgeColor]}`}>{org.badge}</span>
            <h2 class="font-display font-black text-3xl md:text-4xl text-cokro-navy leading-tight mb-1">{org.name}</h2>
            <p class="font-body font-bold text-cokro-sky uppercase tracking-widest text-sm">{org.shortName}</p>
          </div>
        </section>

        <!-- Gallery Photos Section (3 Photos) -->
        <section aria-labelledby="gallery-title">
          <div class="flex items-center gap-3 mb-5">
            <span class="w-10 h-10 rounded-full bg-cokro-gold border-2 border-cokro-navy shadow-3d-solid flex items-center justify-center text-lg">🖼️</span>
            <h3 id="gallery-title" class="font-display font-bold text-2xl text-cokro-navy">Galeri & Dokumentasi</h3>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {(org.gallery && org.gallery.length > 0 ? org.gallery : [
              '/Assets/photos/ormawa/gallery-1.jpg',
              '/Assets/photos/ormawa/gallery-2.jpg',
              '/Assets/photos/ormawa/gallery-3.jpg'
            ]).slice(0, 3).map((imgUrl, idx) => (
              <div class="group relative rounded-card-md border-2 border-cokro-navy shadow-3d-solid overflow-hidden bg-cokro-navy aspect-[4/3]">
                <img
                  src={imgUrl}
                  alt={`Dokumentasi ${org.name} #${idx + 1}`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  onerror={`this.onerror=null; this.src='https://placehold.co/800x600/0F52BA/FFFFFF/webp?text=Foto+${idx + 1}+(800+x+600)';`}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-cokro-navy/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
                  <span class="text-xs font-bold text-white uppercase tracking-wider">Dokumentasi #{idx + 1} (800 x 600)</span>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- D: Deskripsi -->
        <section aria-labelledby="desc-title">
          <div class="flex items-center gap-3 mb-5">
            <span class="w-10 h-10 rounded-full bg-cokro-gold border-2 border-cokro-navy shadow-3d-solid flex items-center justify-center text-lg">📋</span>
            <h3 id="desc-title" class="font-display font-bold text-2xl text-cokro-navy">Deskripsi</h3>
          </div>
          <div class="bg-white rounded-card-md border-2 border-cokro-navy shadow-3d-solid p-6">
            <p class="font-body text-cokro-text-muted leading-relaxed">{org.description}</p>
          </div>
        </section>

        <!-- B: Visi & Misi -->
        <section aria-labelledby="vismis-title">
          <div class="flex items-center gap-3 mb-5">
            <span class="w-10 h-10 rounded-full bg-cokro-blue border-2 border-cokro-navy shadow-3d-solid flex items-center justify-center text-lg">🎯</span>
            <h3 id="vismis-title" class="font-display font-bold text-2xl text-cokro-navy">Visi & Misi</h3>
          </div>
          <div class="grid md:grid-cols-2 gap-6">
            <div class="bg-white rounded-card-md border-2 border-cokro-navy shadow-3d-solid p-6">
              <h4 class="font-display font-bold text-cokro-blue text-lg mb-3 flex items-center gap-2">
                <span class="w-6 h-6 rounded-full bg-cokro-blue text-white text-xs flex items-center justify-center font-black">V</span>
                Visi
              </h4>
              <p class="font-body text-cokro-text-muted leading-relaxed italic">"{org.vision}"</p>
            </div>
            <div class="bg-white rounded-card-md border-2 border-cokro-navy shadow-3d-solid p-6">
              <h4 class="font-display font-bold text-cokro-blue text-lg mb-3 flex items-center gap-2">
                <span class="w-6 h-6 rounded-full bg-cokro-blue text-white text-xs flex items-center justify-center font-black">M</span>
                Misi
              </h4>
              <ul class="space-y-2">
                {org.missions.map((m, i) => (
                  <li class="flex gap-3 font-body text-sm text-cokro-text-muted">
                    <span class="shrink-0 w-6 h-6 rounded-full bg-cokro-gold border border-cokro-navy flex items-center justify-center font-black text-xs text-cokro-navy mt-0.5">{i+1}</span>
                    <span>{m}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>

        <!-- C: Struktur Organisasi -->
        <section aria-labelledby="struct-title">
          <div class="flex items-center gap-3 mb-5">
            <span class="w-10 h-10 rounded-full bg-cokro-sky border-2 border-cokro-navy shadow-3d-solid flex items-center justify-center text-lg">🏛️</span>
            <h3 id="struct-title" class="font-display font-bold text-2xl text-cokro-navy">Struktur Organisasi</h3>
          </div>
          <div class="bg-white rounded-card-md border-2 border-cokro-navy shadow-3d-solid p-6">
            <!-- Pimpinan -->
            <div class="grid sm:grid-cols-3 gap-4 mb-6">
              {[
                { label: 'Pembina', value: org.structure.pembina, color: 'bg-cokro-navy text-white' },
                { label: 'Ketua', value: org.structure.ketua, color: 'bg-cokro-gold text-cokro-navy' },
                { label: 'Wakil Ketua', value: org.structure.wakilKetua, color: 'bg-cokro-blue text-white' },
              ].map(item => (
                <div class={`rounded-xl p-4 text-center border-2 border-cokro-navy shadow-3d-solid ${item.color}`}>
                  <p class="text-xs font-extrabold uppercase tracking-wider opacity-75 mb-1">{item.label}</p>
                  <p class="font-display font-bold text-sm leading-snug">{item.value}</p>
                </div>
              ))}
            </div>
            <!-- Divisi -->
            <h4 class="font-display font-bold text-cokro-blue text-base mb-3">Divisi / Bidang</h4>
            <div class="grid sm:grid-cols-2 gap-3">
              {org.structure.divisions.map(div => (
                <div class="flex items-start gap-3 p-3 bg-cokro-tint rounded-xl border border-cokro-navy/20">
                  <span class="w-2 h-2 rounded-full bg-cokro-gold border border-cokro-navy shrink-0 mt-2"></span>
                  <div>
                    <p class="font-display font-bold text-sm text-cokro-navy">{div.name}</p>
                    <p class="font-body text-xs text-cokro-text-muted">{div.head}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- E: Program Kerja Unggulan -->
        <section aria-labelledby="proker-title">
          <div class="flex items-center gap-3 mb-5">
            <span class="w-10 h-10 rounded-full bg-cokro-gold border-2 border-cokro-navy shadow-3d-solid flex items-center justify-center text-lg">⭐</span>
            <h3 id="proker-title" class="font-display font-bold text-2xl text-cokro-navy">Program Kerja Unggulan</h3>
          </div>
          <div class="grid sm:grid-cols-2 gap-5">
            {org.programs.map((p, i) => (
              <div class="bg-white rounded-card-md border-2 border-cokro-navy shadow-3d-solid hover:-translate-y-1 hover:shadow-3d-solid-hover transition-all duration-200 p-5 flex gap-4">
                <span class="shrink-0 w-10 h-10 rounded-full bg-cokro-tint border-2 border-cokro-navy flex items-center justify-center font-display font-black text-cokro-navy text-sm">{i+1}</span>
                <div>
                  <h4 class="font-display font-bold text-cokro-navy mb-1">{p.name}</h4>
                  <p class="font-body text-sm text-cokro-text-muted leading-relaxed">{p.description}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- F: Prestasi (Opsional) -->
        {org.achievements && org.achievements.length > 0 && (
          <section aria-labelledby="prestasi-title">
            <div class="flex items-center gap-3 mb-5">
              <span class="w-10 h-10 rounded-full bg-yellow-400 border-2 border-cokro-navy shadow-3d-solid flex items-center justify-center text-lg">🏆</span>
              <h3 id="prestasi-title" class="font-display font-bold text-2xl text-cokro-navy">Prestasi</h3>
            </div>
            <div class="bg-white rounded-card-md border-2 border-cokro-navy shadow-3d-solid p-6 space-y-3">
              {org.achievements.map(a => (
                <div class="flex items-start gap-3">
                  <span class="text-xl shrink-0">🥇</span>
                  <p class="font-body text-cokro-text-muted leading-relaxed">{a}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- G: Kontak & Media Sosial -->
        <section aria-labelledby="kontak-title">
          <div class="flex items-center gap-3 mb-5">
            <span class="w-10 h-10 rounded-full bg-pink-400 border-2 border-cokro-navy shadow-3d-solid flex items-center justify-center text-lg">📱</span>
            <h3 id="kontak-title" class="font-display font-bold text-2xl text-cokro-navy">Kontak & Media Sosial</h3>
          </div>
          <div class="flex flex-wrap gap-4">
            {org.contact.instagram && (
              <a href={org.contact.instagram} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-3 px-6 py-3 rounded-pill border-2 border-cokro-navy shadow-3d-solid hover:-translate-y-1 hover:shadow-3d-solid-hover transition-all duration-200 bg-gradient-to-r from-purple-500 to-pink-500 text-white font-display font-bold">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                Instagram
              </a>
            )}
            {org.contact.tiktok && (
              <a href={org.contact.tiktok} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-3 px-6 py-3 rounded-pill border-2 border-cokro-navy shadow-3d-solid hover:-translate-y-1 hover:shadow-3d-solid-hover transition-all duration-200 bg-gray-900 text-white font-display font-bold">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                TikTok
              </a>
            )}
            {org.contact.whatsapp && (
              <a href={org.contact.whatsapp} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-3 px-6 py-3 rounded-pill border-2 border-cokro-navy shadow-3d-solid hover:-translate-y-1 hover:shadow-3d-solid-hover transition-all duration-200 bg-green-500 text-white font-display font-bold">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                WhatsApp
              </a>
            )}
          </div>
        </section>

      </div>
    </main>

    <Footer />
  </body>
</html>
