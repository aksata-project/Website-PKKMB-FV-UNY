---
// StepCard.astro — Step card for Panduan page
interface Props {
  step: number;
  title: string;
  description: string;
  icon?: string;
}
const { step, title, description, icon = '✅' } = Astro.props;
---

<div class="group relative overflow-hidden rounded-card-md border-2 border-cokro-navy bg-white p-6 pt-11 shadow-3d-solid transition-all duration-300 hover:-translate-y-1 hover:shadow-3d-solid-hover">
  <div class="absolute left-0 top-0 h-2 w-full bg-cokro-blue"></div>
  <div class="absolute -bottom-8 -right-8 h-24 w-24 rounded-full border-[12px] border-cokro-gold/15 transition-transform duration-300 group-hover:scale-125"></div>
  <!-- Step Number Blob -->
  <div class="absolute -top-6 -left-3 w-14 h-14 bg-cokro-gold border-4 border-cokro-navy shadow-3d-solid flex items-center justify-center [border-radius:60%_40%_30%_70%/60%_30%_70%_40%]">
    <span class="font-display font-black text-xl text-cokro-navy">{step}</span>
  </div>

  <div class="relative flex items-start gap-3">
    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border-2 border-cokro-navy bg-cokro-tint text-2xl shadow-[3px_3px_0_#0A2540]">{icon}</span>
    <div>
      <h3 class="font-display font-bold text-lg text-cokro-navy mb-2">{title}</h3>
      <p class="font-body text-sm text-cokro-text-muted leading-relaxed">{description}</p>
    </div>
  </div>
</div>
