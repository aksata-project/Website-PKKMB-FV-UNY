---
// Footer.astro — Revised with correct content & navigation links
import SocialIcons from "./SocialIcons.astro";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/timeline", label: "Timeline" },
  { href: "/panduan", label: "Panduan" },
  { href: "/ormawa", label: "Ormawa FV" },
  { href: "/ukm", label: "UKM FV" },
  { href: "/faq", label: "FAQ" },
];
---

<footer
  class="relative z-10 overflow-hidden bg-cokro-navy text-white"
>
  <!-- Wave top divider -->
  <div class="overflow-hidden bg-cokro-tint leading-none">
    <svg
      class="block w-full h-[40px] md:h-[60px]"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
    >
      <path
        d="M0,88 C150,52 300,40 450,72 C600,104 750,92 900,54 C1035,20 1125,26 1200,70 V120 H0 Z"
        class="fill-cokro-navy"></path>
    </svg>
  </div>

  <!-- Doodle pattern overlay -->
  <div class="absolute inset-0 bg-doodle-pattern opacity-5 pointer-events-none">
  </div>
  <!-- Gold glow blobs -->
  <div
    class="absolute bottom-0 left-0 w-64 h-64 bg-cokro-gold/5 rounded-full blur-3xl pointer-events-none"
  >
  </div>
  <div
    class="absolute top-0 right-0 w-48 h-48 bg-cokro-sky/5 rounded-full blur-2xl pointer-events-none"
  >
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-10">
    <div
      class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-10 border-b border-white/10"
    >
      <!-- Brand & Tagline (5 cols) -->
      <div class="md:col-span-5 space-y-4">
        <!-- Logos row -->
        <div class="flex items-center gap-3">
          <div
            class="w-14 h-14 rounded-full bg-white p-1.5 flex items-center justify-center shadow-[4px_4px_0px_#3B82F6] border-2 border-cokro-sky overflow-hidden shrink-0"
          >
            <img
              src="/Assets/logos/pkkmb/logo-pkkmbfv2026.svg"
              alt="PKKMB FV UNY 2026"
              class="w-full h-full object-contain"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="leading-tight">
            <p
              class="font-display font-extrabold text-xl text-white tracking-wide"
            >
              PKKMB FV UNY 2026
            </p>
            <p
              class="text-xs text-cokro-gold font-bold tracking-widest uppercase"
            >
              universitas negeri yogyakarta
            </p>
          </div>
        </div>

        <p class="text-sm text-slate-300 font-body leading-relaxed max-w-sm">
          Pengenalan Kehidupan Kampus bagi Mahasiswa Baru Fakultas Vokasi
          Universitas Negeri Yogyakarta Tahun 2026.
        </p>
        <p class="text-sm font-display font-bold text-cokro-gold italic">
          "Take The Leap, Chase Your Dream"
        </p>

        <!-- Social Media -->
        <div class="pt-1">
          <p
            class="text-xs text-slate-400 mb-2 font-body uppercase tracking-wider"
          >
            Ikuti kami di
          </p>
          <div class="pt-2">
            <SocialIcons size="w-6 h-6" variant="white" />
          </div>
        </div>
      </div>

      <!-- Quick Nav (4 cols) -->
      <div class="md:col-span-4 space-y-3">
        <h4
          class="font-display font-bold text-base text-cokro-gold uppercase tracking-wider mb-4"
        >
          Navigasi Cepat
        </h4>
        <div class="grid grid-cols-2 gap-x-4 gap-y-2">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="font-body text-sm text-slate-300 hover:text-cokro-gold hover:translate-x-1 transition-all duration-200 flex items-center gap-1"
              >
                <span class="w-1 h-1 rounded-full bg-cokro-gold/60 shrink-0" />
                {link.label}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Contact Info (3 cols) -->
      <div class="md:col-span-3 space-y-3">
        <h4
          class="font-display font-bold text-base text-cokro-gold uppercase tracking-wider mb-4"
        >
          Sekretariat
        </h4>
        <div class="space-y-3 text-sm font-body text-slate-300">
          <div class="flex gap-2">
            <span class="shrink-0 mt-0.5">📍</span>
            <p class="leading-relaxed">
              Gedung Dekanat Fakultas Vokasi UNY, Kampus Wates, Jl. Terusan
              Pengasih, Kulon Progo, D.I. Yogyakarta 55652
            </p>
          </div>
          <div class="flex gap-2">
            <span class="shrink-0">✉️</span>
            <a
              href="mailto:pkkmbfvuny.web@gmail.com"
              class="hover:text-cokro-gold transition-colors"
              >pkkmbfvuny.web@gmail.com</a
            >
          </div>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div
      class="pt-8 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-slate-400 font-body"
    >
      <p>© 2026 PKKMB Fakultas Vokasi UNY. All Rights Reserved.</p>
      <p>
        Powered By <span class="text-cokro-gold font-bold"
          >Cokro Aksata Nusantara</span
        >.
      </p>
    </div>
  </div>
</footer>
