---
// Welcome.astro — Revised: YouTube direct embed, Swiper full controls & drag, Mascot animation
import "swiper/css";
import "swiper/css/pagination";
import "swiper/css/navigation";
import "swiper/css/autoplay";

import { Image } from "astro:assets";

// Ambil semua foto galeri dari src/assets
const galleryGlob = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/photos/gallery/*.webp",
  { eager: true },
);

const galleryImages = [
  {
    src: galleryGlob["/src/assets/photos/gallery/pkkmb-uny-1.webp"]?.default,
    alt: "Dokumentasi PKKMB KM FV UNY 2025 — Momen Kebersamaan #1",
  },
  {
    src: galleryGlob["/src/assets/photos/gallery/pkkmb-kp-1.webp"]?.default,
    alt: "Keseruan PKKMB KM FV UNY 2025 — Kampus Kulon Progo #1",
  },
  {
    src: galleryGlob["/src/assets/photos/gallery/pkkmb-kp-2.webp"]?.default,
    alt: "Keseruan PKKMB KM FV UNY 2025 — Kampus Kulon Progo #2",
  },
  {
    src: galleryGlob["/src/assets/photos/gallery/pkkmb-kp-3.webp"]?.default,
    alt: "Keseruan PKKMB KM FV UNY 2025 — Kampus Kulon Progo #3",
  },
  {
    src: galleryGlob["/src/assets/photos/gallery/pkkmb-kp-gk-1.webp"]?.default,
    alt: "Dokumentasi PKKMB KM FV UNY 2025 — Kampus KP & GK #1",
  },
  {
    src: galleryGlob["/src/assets/photos/gallery/pkkmb-kp-gk-2.webp"]?.default,
    alt: "Dokumentasi PKKMB KM FV UNY 2025 — Kampus KP & GK #2",
  },
  {
    src: galleryGlob["/src/assets/photos/gallery/pkkmb-gunkid-1.webp"]?.default,
    alt: "Keseruan PKKMB KM FV UNY 2025 — Kampus Gunungkidul #1",
  },
  {
    src: galleryGlob["/src/assets/photos/gallery/pkkmb-gunkid-3.webp"]?.default,
    alt: "Keseruan PKKMB KM FV UNY 2025 — Kampus Gunungkidul #2",
  },
  {
    src: galleryGlob["/src/assets/photos/gallery/pkkmb-gk-2.webp"]?.default,
    alt: "Antusiasme Peserta PKKMB KM FV UNY 2025 — Gunungkidul",
  },
  {
    src: galleryGlob["/src/assets/photos/gallery/tmtp-kp.webp"]?.default,
    alt: "Sesi TMTP PKKMB KM FV UNY 2025 — Kampus Kulon Progo",
  },
  {
    src: galleryGlob["/src/assets/photos/gallery/tmtp-gk.webp"]?.default,
    alt: "Sesi TMTP PKKMB KM FV UNY 2025 — Kampus Gunungkidul",
  },
].filter((item): item is { src: ImageMetadata; alt: string } =>
  Boolean(item.src),
);

// Maskot FV
const mascotGlob = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/*.{webp,png,jpg,svg}",
  { eager: true },
);
const mascotObj = mascotGlob["/src/assets/images/maskot-fv.webp"]?.default;
---

<section
  id="welcome"
  class="relative overflow-hidden bg-white px-4 py-24 sm:px-6 lg:px-8"
  aria-labelledby="welcome-title"
>
  <!-- Mixed decorative background -->
  <div
    class="absolute inset-0 bg-doodle-pattern opacity-[0.08] pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute -left-20 top-20 h-56 w-56 rounded-full bg-cokro-gold/20 blur-3xl pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute -right-24 top-1/3 h-72 w-72 rounded-full bg-cokro-sky/20 blur-3xl pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute right-[8%] top-24 hidden h-24 w-24 rounded-full border-4 border-cokro-blue/20 sm:block"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute left-[8%] top-48 hidden text-4xl text-cokro-gold/70 sm:block"
    aria-hidden="true"
  >
    ✦
  </div>
  <div
    class="absolute right-[12%] bottom-32 hidden text-3xl text-cokro-blue/40 sm:block"
    aria-hidden="true"
  >
    ✦
  </div>

  <!-- PEEKING & FLOATING MASCOT ON RIGHT SIDE -->
  <div
    id="mascot-peeking-container"
    class="pointer-events-none absolute right-2 sm:right-6 md:right-10 lg:right-16 top-4 sm:top-6 z-20 w-40 sm:w-64 md:w-80 lg:w-96 opacity-100"
    aria-hidden="true"
  >
    <div class="mascot-tilt-wrapper transition-transform duration-700 ease-out">
      {
        mascotObj ? (
          <Image
            src={mascotObj}
            alt="Maskot Fakultas Vokasi UNY"
            class="w-full h-auto object-contain drop-shadow-[0_15px_30px_rgba(10,37,64,0.3)]"
            loading="lazy"
          />
        ) : (
          <div class="w-full h-64 border-2 border-dashed border-cokro-gold/40 rounded-card-md flex items-center justify-center text-xs text-cokro-navy/70 p-4 text-center bg-cokro-tint/50 backdrop-blur-sm">
            📌 Upload <code>maskot-fv.webp</code> ke{" "}
            <code>src/assets/images/</code>
          </div>
        )
      }
    </div>
  </div>

  <div class="relative z-10 mx-auto max-w-5xl">
    <!-- Section heading -->
    <div class="relative text-center mb-12">
      <span
        class="inline-block px-4 py-1.5 bg-cokro-gold text-cokro-navy font-display font-extrabold text-sm rounded-pill shadow-3d-solid mb-4 uppercase tracking-widest"
        >SELAMAT DATANG</span
      >
      <h2
        id="welcome-title"
        class="font-display font-bold text-4xl md:text-5xl text-cokro-navy mb-4 relative z-10"
      >
        SALAM PRAKTISI MUDA !!
      </h2>
      <p
        class="font-body text-lg text-cokro-text-muted max-w-2xl mx-auto leading-relaxed relative z-10"
      >
        Selamat datang di keluarga besar Fakultas Vokasi Universitas Negeri
        Yogyakarta!<br />
      </p>
      <svg
        class="mx-auto mt-5 h-7 w-36 text-cokro-blue"
        viewBox="0 0 144 28"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M4 14c14-18 24 18 38 0s24 18 38 0 24 18 38 0 14 6 22 0"
          stroke="currentColor"
          stroke-width="4"
          stroke-linecap="round"></path>
      </svg>
    </div>

    <!-- ─── YouTube Embed — Center, Highlighted ─── -->
    <div class="mb-14">
      <!-- Highlighted title -->
      <div class="flex items-center justify-center gap-4 mb-6">
        <div class="flex-1 max-w-[80px] h-1 bg-cokro-gold rounded-full"></div>
        <h3
          class="font-display font-black text-2xl md:text-3xl text-cokro-navy text-center"
        >
          Glimpse of PKKMB FV UNY 2025
        </h3>
        <div class="flex-1 max-w-[80px] h-1 bg-cokro-gold rounded-full"></div>
      </div>

      <!-- YouTube Direct Autoplay Iframe -->
      <div
        class="rounded-card-lg border-4 border-cokro-navy shadow-3d-solid-lg overflow-hidden bg-cokro-navy"
      >
        <!-- Gold accent bar top -->
        <div class="h-2 w-full bg-cokro-gold"></div>
        <div
          class="relative w-full overflow-hidden"
          style="padding-bottom: 56.25%; height: 0;"
        >
          <iframe
            src="https://www.youtube.com/embed/blRWOn1KXSE?autoplay=1&mute=1&loop=1&playlist=blRWOn1KXSE&rel=0"
            title="After Movie PKKMB FV UNY 2025"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            loading="eager"
            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;"
          ></iframe>
        </div>
      </div>
      <p
        class="mt-3 text-sm font-body text-cokro-text-muted text-center italic"
      >
        After Movie PKKMB FV UNY 2025
      </p>
    </div>

    <!-- ─── Photo Slider — Below YouTube ─── -->
    <div>
      <p
        class="text-center font-display font-bold text-lg text-cokro-navy mb-6"
      >
        Intip keseruan PKKMB KM FV UNY 2025
      </p>

      <!-- Swiper gallery -->
      <div
        class="relative rounded-card-lg border-2 border-cokro-navy shadow-3d-solid-lg overflow-hidden bg-cokro-tint"
      >
        <div
          class="swiper maba-slider w-full h-[220px] sm:h-[320px] md:h-[400px]"
        >
          <div class="swiper-wrapper">
            {
              galleryImages.map((img) => (
                <div class="swiper-slide w-full h-full cursor-grab active:cursor-grabbing">
                  <Image
                    src={img.src}
                    alt={img.alt}
                    loading="lazy"
                    class="w-full h-full object-cover select-none pointer-events-none"
                    width={800}
                    height={450}
                  />
                </div>
              ))
            }
          </div>
          <!-- Pagination -->
          <div class="swiper-pagination"></div>
          <!-- Navigation -->
          <div class="swiper-button-prev !text-white !drop-shadow-md"></div>
          <div class="swiper-button-next !text-white !drop-shadow-md"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import Swiper from "swiper";
  import { Navigation, Pagination, Autoplay } from "swiper/modules";

  function initWelcomeSlider() {
    // Intersection Observer for Mascot Entrance & Exit Re-trigger
    const mascotContainer = document.getElementById("mascot-peeking-container");
    const welcomeSection = document.getElementById("welcome");
    if (mascotContainer && welcomeSection) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              mascotContainer.classList.add("is-visible");
            } else {
              mascotContainer.classList.remove("is-visible");
            }
          });
        },
        { threshold: 0 },
      );
      observer.observe(welcomeSection);
      // Immediate check if already visible on load
      const rect = welcomeSection.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        mascotContainer.classList.add("is-visible");
      }
    }

    const sliderEl = document.querySelector(".maba-slider");
    if (sliderEl) {
      new Swiper(".maba-slider", {
        modules: [Navigation, Pagination, Autoplay],
        loop: true,
        slidesPerView: 1,
        spaceBetween: 0,
        grabCursor: true,
        simulateTouch: true,
        allowTouchMove: true,
        pagination: {
          el: ".swiper-pagination",
          clickable: true,
        },
        navigation: {
          nextEl: ".swiper-button-next",
          prevEl: ".swiper-button-prev",
        },
        autoplay: {
          delay: 3500,
          disableOnInteraction: false,
        },
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initWelcomeSlider);
  } else {
    initWelcomeSlider();
  }
  document.addEventListener("astro:page-load", initWelcomeSlider);
</script>

<style>
  /* Mascot Entrance & Swaying Animation */
  .mascot-tilt-wrapper {
    opacity: 1;
    transform: rotate(-15deg);
    animation: mascot-sway-idle 4s ease-in-out infinite;
  }

  #mascot-peeking-container.is-visible .mascot-tilt-wrapper {
    animation: mascot-sway-idle 4s ease-in-out infinite;
  }

  @keyframes mascot-sway-idle {
    0%,
    100% {
      transform: translateY(0px) rotate(-15deg);
    }
    50% {
      transform: translateY(-12px) rotate(-8deg);
    }
  }
</style>
