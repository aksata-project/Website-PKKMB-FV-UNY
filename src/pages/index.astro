---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/home/Hero.astro';
import Welcome from '../components/home/Welcome.astro';
import Introduction from '../components/home/Introduction.astro';
import Philosophy from '../components/home/Philosophy.astro';
import AboutFaculty from '../components/home/AboutFaculty.astro';
import CampusMap from '../components/home/CampusMap.astro';

// Global Styles
import '../styles/global.css';

const heroBg = '/Assets/illustrations/background/home-bg.webp';
const heroCta = '/Assets/illustrations/words/home-cta1.webp';
---

<BaseLayout
  title="PKKMB FV UNY 2026 | Cokro Aksata"
  description="Website Resmi PKKMB Fakultas Vokasi Universitas Negeri Yogyakarta 2026. Take the leap, chase your dream!"
  bodyClass="relative"
  preloadImages={[heroBg, heroCta]}
>
  <!-- Fixed Background Elements -->
  <div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden bg-gradient-to-b from-white to-cokro-tint">
    <!-- Animated Clouds -->
    <div class="absolute top-24 -left-32 text-cokro-blue/10 animate-cloud-slow">
      <svg width="200" height="100" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 19c2.5 0 4.5-2 4.5-4.5S20 10 17.5 10c-.3 0-.6 0-.8.1-.5-2.8-2.9-5-5.9-5.1-3 0-5.6 2.1-6.2 5C2 10 0 12 0 14.5S2 19 4.5 19h13z"/></svg>
    </div>
    <div class="absolute top-64 -left-64 text-white/50 animate-cloud-fast" style="animation-delay: 5s;">
      <svg width="150" height="80" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 19c2.5 0 4.5-2 4.5-4.5S20 10 17.5 10c-.3 0-.6 0-.8.1-.5-2.8-2.9-5-5.9-5.1-3 0-5.6 2.1-6.2 5C2 10 0 12 0 14.5S2 19 4.5 19h13z"/></svg>
    </div>
    <div class="absolute top-1/2 -left-48 text-cokro-sky/15 animate-cloud-slow" style="animation-delay: -30s;">
      <svg width="300" height="150" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 19c2.5 0 4.5-2 4.5-4.5S20 10 17.5 10c-.3 0-.6 0-.8.1-.5-2.8-2.9-5-5.9-5.1-3 0-5.6 2.1-6.2 5C2 10 0 12 0 14.5S2 19 4.5 19h13z"/></svg>
    </div>
    
    <!-- Fixed Cityscape Silhouette at Bottom -->
    <div class="absolute bottom-0 left-0 w-full h-[30vh] flex items-end opacity-10">
      <!-- SVG Cityscape Path -->
      <svg class="w-full h-full" preserveAspectRatio="none" viewBox="0 0 1000 200" fill="currentColor" xmlns="http://www.w3.org/2000/svg" style="color: #0F52BA;">
        <path d="M0 200V150H30V100H60V120H100V80H130V140H180V60H220V120H260V40H300V100H350V70H400V130H450V90H490V160H530V100H570V50H610V110H650V80H700V140H740V60H780V120H820V90H860V140H900V50H940V120H970V80H1000V200H0Z"/>
      </svg>
    </div>
  </div>

  <Navbar />
  
  <main class="w-full">
    <Hero />
    <Welcome />
    <Introduction />
    <Philosophy />
    <AboutFaculty />
    <CampusMap />
  </main>

  <Footer />
</BaseLayout>
