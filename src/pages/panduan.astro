---
// src/pages/panduan.astro
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import PageHeader from '../components/ui/PageHeader.astro';

const documentResources = [
  { title: 'Guidebook PKKMB', description: 'Panduan lengkap rangkaian kegiatan dan kebutuhan peserta.', icon: '📘', color: 'bg-cokro-blue text-white', href: null as string | null },
  { title: 'Tata Tertib', description: 'Dokumen resmi aturan dan ketentuan selama PKKMB berlangsung.', icon: '⚖️', color: 'bg-cokro-gold text-cokro-navy', href: null as string | null },
  { title: 'Pemaparan Advokasi', description: 'Materi layanan advokasi dan kanal bantuan mahasiswa baru.', icon: '🫱🏻‍🫲🏽', color: 'bg-red-500 text-white', href: null as string | null },
];

---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panduan PKKMB FV UNY 2026 — Cokro Aksata</title>
    <meta name="description" content="Panduan registrasi, tata tertib, dan dresscode PKKMB Fakultas Vokasi UNY 2026." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400..700&family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..800&family=Sniglet:wght@400;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-cokro-tint text-cokro-navy font-body antialiased overflow-x-hidden selection:bg-cokro-gold selection:text-cokro-navy">
    <Navbar />

    <PageHeader
      title="Panduan PKKMB"
      subtitle="Semua informasi yang kamu butuhkan — dari cara daftar hingga apa yang harus dipakai. Baca dengan seksama, ya!"
      badge="Panduan Peserta"
    />

    <main class="py-20 px-4 sm:px-6 lg:px-8">
      <div class="max-w-6xl mx-auto space-y-24">

        <!-- Pusat dokumen dan informasi peserta -->
        <section aria-labelledby="resources-title" class="relative overflow-hidden rounded-card-lg border-4 border-cokro-navy bg-white p-6 shadow-3d-solid-lg sm:p-8">
          <div class="absolute -right-16 -top-16 h-48 w-48 rounded-full bg-cokro-gold/20 blur-3xl"></div>
          <div class="relative">
            <div class="mb-8 flex flex-col gap-3 text-center sm:text-left">
              <span class="w-fit self-center rounded-pill border-2 border-cokro-navy bg-cokro-gold px-4 py-1.5 font-display text-xs font-black text-cokro-navy shadow-3d-solid sm:self-start">PUSAT INFORMASI</span>
              <div>
                <h2 id="resources-title" class="font-display text-3xl font-black text-cokro-navy sm:text-4xl">Dokumen Peserta</h2>
                <p class="mt-2 max-w-2xl font-body text-sm leading-relaxed text-cokro-text-muted">Simpan tiga dokumen ini sebelum kegiatan dimulai. Tombol akan aktif setelah tautan resmi Google Drive dipublikasikan.</p>
              </div>
            </div>
            <div class="grid gap-5 md:grid-cols-3">
              {documentResources.map((resource) => (
                <article class="relative overflow-hidden rounded-card-md border-2 border-cokro-navy bg-white p-5 shadow-3d-solid">
                  <div class={`mb-5 flex h-14 w-14 items-center justify-center rounded-xl border-2 border-cokro-navy text-3xl shadow-[3px_3px_0_#0A2540] ${resource.color}`}>{resource.icon}</div>
                  <h3 class="font-display text-xl font-black text-cokro-navy">{resource.title}</h3>
                  <p class="mt-2 min-h-12 font-body text-sm leading-relaxed text-cokro-text-muted">{resource.description}</p>
                  {resource.href ? (
                    <a href={resource.href} target="_blank" rel="noreferrer" class="mt-5 inline-flex rounded-pill border-2 border-cokro-navy bg-cokro-blue px-4 py-2 font-display text-xs font-black text-white shadow-3d-solid transition-all hover:-translate-y-0.5 hover:shadow-3d-solid-hover">Buka Google Drive ↗</a>
                  ) : (
                    <span aria-disabled="true" class="mt-5 inline-flex rounded-pill border-2 border-cokro-navy bg-cokro-tint px-4 py-2 font-display text-xs font-black text-cokro-text-muted">LINK MENYUSUL</span>
                  )}
                </article>
              ))}
            </div>
          </div>
        </section>

      </div>
    </main>

    <Footer />
  </body>
</html>
