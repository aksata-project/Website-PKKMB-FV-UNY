---
// OrgModal.astro — Generic modal for Ormawa & UKM detail
---

<!-- Modal Overlay -->
<div
  id="org-modal"
  class="fixed inset-0 z-[200] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-label="Detail organisasi"
>
  <!-- Backdrop -->
  <div id="org-modal-backdrop" class="absolute inset-0 bg-cokro-navy/60 backdrop-blur-sm"></div>

  <!-- Modal Box -->
  <div class="relative z-10 w-full max-w-lg bg-white rounded-card-lg border-4 border-cokro-navy shadow-3d-solid-hover scale-90 transition-transform duration-300" id="org-modal-box">
    <!-- Close Button -->
    <button
      id="org-modal-close"
      class="absolute -top-4 -right-4 w-10 h-10 rounded-full bg-cokro-gold border-2 border-cokro-navy shadow-3d-solid flex items-center justify-center hover:-translate-y-1 transition-transform z-20"
      aria-label="Tutup modal"
    >
      <svg class="w-5 h-5 text-cokro-navy" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <!-- Header (blue band) -->
    <div class="bg-cokro-header rounded-t-[20px] p-6 flex flex-col items-center text-center">
      <div class="w-24 h-24 rounded-full bg-white border-4 border-cokro-gold shadow-3d-solid flex items-center justify-center mb-3">
        <img id="modal-logo" src="" alt="" class="w-16 h-16 object-contain" loading="lazy" />
      </div>
      <span id="modal-badge" class="px-3 py-1 bg-cokro-gold text-cokro-navy text-xs font-extrabold uppercase tracking-widest rounded-pill mb-2"></span>
      <h2 id="modal-name" class="font-display font-black text-2xl text-white drop-shadow-[2px_2px_0_#0A2540]"></h2>
      <p id="modal-short-name" class="text-white/70 text-sm font-bold uppercase tracking-wider mt-1"></p>
    </div>

    <!-- Body -->
    <div class="p-6 space-y-4 max-h-[50vh] overflow-y-auto">
      <div>
        <h4 class="font-display font-bold text-cokro-blue text-base mb-2">Tentang</h4>
        <p id="modal-description" class="font-body text-sm text-cokro-text-muted leading-relaxed"></p>
      </div>
      <div>
        <h4 class="font-display font-bold text-cokro-blue text-base mb-2">Visi</h4>
        <p id="modal-vision" class="font-body text-sm text-cokro-text-muted leading-relaxed italic">Placeholder visi organisasi.</p>
      </div>
      <div>
        <h4 class="font-display font-bold text-cokro-blue text-base mb-2">Misi</h4>
        <ul id="modal-missions" class="space-y-1 text-sm text-cokro-text-muted font-body list-disc list-outside ml-4">
          <li>Placeholder misi 1.</li>
          <li>Placeholder misi 2.</li>
          <li>Placeholder misi 3.</li>
        </ul>
      </div>
    </div>

    <!-- Footer -->
    <div class="px-6 pb-6">
      <p class="text-xs text-cokro-text-muted text-center font-body">Kontak & sosial media organisasi segera hadir.</p>
    </div>
  </div>
</div>

<script>
  // Map to store org data from cards
  type OrgData = {
    logo: string;
    name: string;
    shortName: string;
    description: string;
    badge: string;
  };
  const orgDataMap = new Map<string, OrgData>();

  // Populate map from card data attributes
  document.querySelectorAll<HTMLElement>('.org-card').forEach(card => {
    const id = card.dataset.id!;
    orgDataMap.set(id, {
      logo: card.dataset.logo!,
      name: card.dataset.name!,
      shortName: card.dataset.shortName!,
      description: card.dataset.description!,
      badge: card.dataset.badge!,
    });
  });

  const modal     = document.getElementById('org-modal')!;
  const modalBox  = document.getElementById('org-modal-box')!;
  const backdrop  = document.getElementById('org-modal-backdrop')!;
  const closeBtn  = document.getElementById('org-modal-close')!;

  function openModal(id: string) {
    const d = orgDataMap.get(id);
    if (!d) return;
    (document.getElementById('modal-logo') as HTMLImageElement).src  = d.logo;
    (document.getElementById('modal-logo') as HTMLImageElement).alt  = d.name;
    document.getElementById('modal-name')!.textContent       = d.name;
    document.getElementById('modal-short-name')!.textContent = d.shortName;
    document.getElementById('modal-description')!.textContent = d.description;
    document.getElementById('modal-badge')!.textContent      = d.badge;
    modal.classList.remove('opacity-0', 'pointer-events-none');
    modalBox.classList.remove('scale-90');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.add('opacity-0', 'pointer-events-none');
    modalBox.classList.add('scale-90');
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLElement>('.org-card').forEach(card => {
    card.addEventListener('click', () => openModal(card.dataset.id!));
    card.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') openModal(card.dataset.id!); });
  });

  closeBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
</script>
