---
// Hero.astro — Revised with "2026" text, decorative elements, better visual
---

<section
  class="relative min-h-[100vh] flex flex-col items-center justify-center pt-24 pb-40 px-4 sm:px-6 lg:px-8 bg-cover bg-center overflow-hidden"
  style="background-image: url('/Assets/illustrations/background/home-bg.webp');"
  aria-label="Hero Section"
>
  <!-- Light overlay -->
  <div class="absolute inset-0 pointer-events-none bg-white/5 z-0"></div>

  <!-- Animated clouds -->
  <div class="hero-clouds absolute inset-0 z-[1] overflow-hidden pointer-events-none" aria-hidden="true">
    <svg class="hero-cloud hero-cloud-one" viewBox="0 0 260 100" aria-hidden="true">
      <path d="M28 76C12 76 2 66 2 52c0-13 10-24 23-25C31 11 44 1 61 1c18 0 33 12 37 29 5-4 12-6 19-6 17 0 30 12 31 28 13 1 23 11 23 24H28Z" fill="#3B82F6" />
    </svg>
    <svg class="hero-cloud hero-cloud-two" viewBox="0 0 260 100" aria-hidden="true">
      <path d="M28 76C12 76 2 66 2 52c0-13 10-24 23-25C31 11 44 1 61 1c18 0 33 12 37 29 5-4 12-6 19-6 17 0 30 12 31 28 13 1 23 11 23 24H28Z" fill="#3B82F6" />
    </svg>
    <svg class="hero-cloud hero-cloud-three" viewBox="0 0 260 100" aria-hidden="true">
      <path d="M28 76C12 76 2 66 2 52c0-13 10-24 23-25C31 11 44 1 61 1c18 0 33 12 37 29 5-4 12-6 19-6 17 0 30 12 31 28 13 1 23 11 23 24H28Z" fill="#3B82F6" />
    </svg>
  </div>

  <!-- ✨ Decorative: floating star sparks -->
  <div
    class="absolute top-24 left-8 w-6 h-6 text-yellow-300 text-3xl animate-bounce pointer-events-none z-0"
  >
    ✦
  </div>
  <div
    class="absolute top-40 right-12 w-4 h-4 text-white text-2xl animate-pulse pointer-events-none z-0"
  >
    ✦
  </div>
  <div
    class="absolute bottom-40 left-16 text-cokro-gold text-4xl animate-bounce [animation-delay:0.5s] pointer-events-none z-0"
  >
    ✦
  </div>
  <div
    class="absolute top-32 right-1/4 text-white/60 text-xl animate-ping [animation-delay:1s] pointer-events-none z-0"
  >
    ✦
  </div>
  <div
    class="absolute bottom-60 right-10 text-yellow-200 text-3xl animate-bounce [animation-delay:1.5s] pointer-events-none z-0"
  >
    ★
  </div>

  <!-- ✨ Decorative: floating rings -->
  <div
    class="absolute top-28 right-8 w-20 h-20 rounded-full border-4 border-white/20 pointer-events-none z-0 animate-[spin_12s_linear_infinite]"
  >
  </div>
  <div
    class="absolute bottom-32 left-8 w-32 h-32 rounded-full border-4 border-cokro-gold/30 pointer-events-none z-0 animate-[spin_18s_linear_infinite_reverse]"
  >
  </div>
  <div
    class="absolute top-1/2 right-4 w-12 h-12 rounded-full border-2 border-white/30 pointer-events-none z-0 animate-[spin_8s_linear_infinite]"
  >
  </div>

  <!-- ✨ Decorative: glowing blob left -->
  <div
    class="absolute left-0 top-1/3 w-64 h-64 bg-cokro-gold/10 rounded-full blur-3xl pointer-events-none z-0"
  >
  </div>
  <div
    class="absolute right-0 bottom-1/4 w-64 h-64 bg-blue-300/10 rounded-full blur-3xl pointer-events-none z-0"
  >
  </div>

  <!-- Mixed graphic elements -->
  <div
    class="hero-mix-shape absolute left-[6%] top-[28%] h-20 w-20 rotate-12 rounded-[42%_58%_62%_38%/55%_38%_62%_45%] bg-cokro-gold/25 shadow-[6px_6px_0_#0A2540]/20 pointer-events-none z-[2]"
  ></div>
  <div
    class="hero-mix-shape hero-mix-shape-secondary absolute right-[7%] bottom-[28%] h-28 w-28 -rotate-12 rounded-[58%_42%_38%_62%/45%_62%_38%_55%] border-4 border-cokro-blue/30 pointer-events-none z-[2]"
  ></div>
  <svg
    class="absolute left-[14%] bottom-[24%] h-16 w-28 text-cokro-gold/70 pointer-events-none z-[2]"
    viewBox="0 0 120 60"
    fill="none"
    aria-hidden="true"
  >
    <path d="M4 42c12-30 22 30 34 0s22 30 34 0 22 30 44-6" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
  </svg>

  <div
    class="relative z-10 w-full max-w-5xl mx-auto text-center flex flex-col items-center"
  >
    <!-- Main Title Image -->
    <div
      class="mb-0 w-full max-w-4xl px-2 transform hover:scale-105 transition-transform duration-500"
    >
      <img
        src="/Assets/illustrations/words/home-cta1.webp"
        alt="PKKMB FV UNY 2026"
        class="w-full h-auto drop-shadow-[0_10px_30px_rgba(0,0,0,0.4)]"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <!-- "2025" large floating badge -->
    <div class="-mt-2 mb-4 flex items-center justify-center gap-1 md:-mt-5">
      <span
        class="font-display font-black text-7xl leading-none text-cokro-gold drop-shadow-[4px_4px_0_#0A2540] [-webkit-text-stroke:2px_#0A2540] select-none sm:text-8xl md:text-9xl"
        >2026</span
      >
    </div>

    <!-- Welcome sub-text -->
    <p
      class="font-display font-bold text-base md:text-xl text-cokro-blue/90 mb-4 max-w-2xl leading-relaxed drop-shadow-md px-2"
    >
      Selamat Datang Mahasiswa Baru Fakultas Vokasi<br
        class="hidden md:block"
      /> Universitas Negeri Yogyakarta
    </p>

    <!-- Tagline -->
    <h2
      class="text-2xl md:text-4xl text-cokro-gold mb-10 lowercase tracking-wider font-extrabold font-['Sniglet','Fredoka',cursive] drop-shadow-[4px_4px_0_#0A2540] [-webkit-text-stroke:2px_#0A2540]"
    >
      Take the leap, chase your dream
    </h2>

    <!-- CTA Button -->
    <a
      href="#welcome"
      class="inline-flex items-center justify-center gap-2 px-8 py-4 text-lg font-bold text-cokro-navy bg-cokro-gold border-2 border-cokro-navy rounded-pill shadow-3d-solid hover:-translate-y-1 hover:shadow-3d-solid-hover active:translate-y-1 active:shadow-3d-solid-pressed transition-all duration-200"
    >
      Mulai Perjalanan ↓
    </a>

    <!-- Countdown Timer -->
    <div
      class="mt-10 grid grid-cols-4 gap-2.5 sm:gap-4 md:gap-6 max-w-xl mx-auto w-full px-2"
      id="countdown-container"
    >
      <!-- Days -->
      <div
        class="flex flex-col items-center justify-center py-2.5 px-1 sm:py-4 sm:px-2 bg-white border-3 sm:border-4 border-cokro-navy rounded-2xl shadow-3d-solid sm:shadow-3d-solid-lg transition-all duration-200 hover:-translate-y-1 h-20 sm:h-28 md:h-32"
      >
        <span
          class="font-display font-black text-2xl sm:text-4xl md:text-5xl text-cokro-blue countdown-value tabular-nums leading-none mb-1"
          id="days">00</span
        >
        <span class="text-[10px] sm:text-xs font-black text-cokro-navy uppercase tracking-wider"
          >Hari</span
        >
      </div>
      <!-- Hours -->
      <div
        class="flex flex-col items-center justify-center py-2.5 px-1 sm:py-4 sm:px-2 bg-white border-3 sm:border-4 border-cokro-navy rounded-2xl shadow-3d-solid sm:shadow-3d-solid-lg transition-all duration-200 hover:-translate-y-1 h-20 sm:h-28 md:h-32"
      >
        <span
          class="font-display font-black text-2xl sm:text-4xl md:text-5xl text-cokro-blue countdown-value tabular-nums leading-none mb-1"
          id="hours">00</span
        >
        <span class="text-[10px] sm:text-xs font-black text-cokro-navy uppercase tracking-wider"
          >Jam</span
        >
      </div>
      <!-- Minutes -->
      <div
        class="flex flex-col items-center justify-center py-2.5 px-1 sm:py-4 sm:px-2 bg-white border-3 sm:border-4 border-cokro-navy rounded-2xl shadow-3d-solid sm:shadow-3d-solid-lg transition-all duration-200 hover:-translate-y-1 h-20 sm:h-28 md:h-32"
      >
        <span
          class="font-display font-black text-2xl sm:text-4xl md:text-5xl text-cokro-blue countdown-value tabular-nums leading-none mb-1"
          id="minutes">00</span
        >
        <span class="text-[10px] sm:text-xs font-black text-cokro-navy uppercase tracking-wider"
          >Menit</span
        >
      </div>
      <!-- Seconds -->
      <div
        class="flex flex-col items-center justify-center py-2.5 px-1 sm:py-4 sm:px-2 bg-white border-3 sm:border-4 border-cokro-navy rounded-2xl shadow-3d-solid sm:shadow-3d-solid-lg transition-all duration-200 hover:-translate-y-1 h-20 sm:h-28 md:h-32"
      >
        <span
          class="font-display font-black text-2xl sm:text-4xl md:text-5xl text-cokro-blue countdown-value tabular-nums leading-none mb-1"
          id="seconds">00</span
        >
        <span class="text-[10px] sm:text-xs font-black text-cokro-navy uppercase tracking-wider"
          >Detik</span
        >
      </div>
    </div>
  </div>

  <!-- Wave transition to Welcome section -->
  <div
    class="absolute bottom-0 left-0 z-20 h-[90px] w-full overflow-hidden leading-none pointer-events-none md:h-[140px]"
  >
    <svg
      class="hero-wave-layer relative block h-full w-full"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        d="M0,45 C140,110 290,105 450,42 C600,-20 760,12 900,65 C1030,112 1125,106 1200,35 V120 H0 Z"
        class="fill-white"
      ></path>
    </svg>
  </div>
</section>

<script>
  function initCountdown() {
    const targetDate = new Date("August 20, 2026 00:00:00").getTime();
    const daysEl = document.getElementById("days");
    const hoursEl = document.getElementById("hours");
    const minutesEl = document.getElementById("minutes");
    const secondsEl = document.getElementById("seconds");
    if (!daysEl || !hoursEl || !minutesEl || !secondsEl) return;

    function update() {
      const distance = targetDate - Date.now();
      if (distance < 0) {
        [daysEl, hoursEl, minutesEl, secondsEl].forEach(
          (el) => (el.innerText = "00"),
        );
        return;
      }
      daysEl.innerText = String(Math.floor(distance / 86400000)).padStart(
        2,
        "0",
      );
      hoursEl.innerText = String(
        Math.floor((distance % 86400000) / 3600000),
      ).padStart(2, "0");
      minutesEl.innerText = String(
        Math.floor((distance % 3600000) / 60000),
      ).padStart(2, "0");
      secondsEl.innerText = String(
        Math.floor((distance % 60000) / 1000),
      ).padStart(2, "0");
    }
    update();
    setInterval(update, 1000);
  }
  document.addEventListener("DOMContentLoaded", initCountdown);
</script>
<style>
  .hero-cloud {
    position: absolute;
    width: clamp(150px, 22vw, 280px);
    opacity: 0.32;
    filter: blur(0.2px);
  }

  .hero-cloud-one {
    top: 18%;
    left: -22%;
    animation: hero-cloud-drift-one 42s linear infinite;
  }

  .hero-cloud-two {
    top: 34%;
    left: -30%;
    width: clamp(120px, 17vw, 220px);
    opacity: 0.22;
    animation: hero-cloud-drift-two 58s linear infinite;
    animation-delay: -18s;
  }

  .hero-cloud-three {
    top: 52%;
    left: -26%;
    width: clamp(180px, 26vw, 330px);
    opacity: 0.16;
    animation: hero-cloud-drift-three 70s linear infinite;
    animation-delay: -35s;
  }

  .hero-wave-layer {
    transform-origin: center bottom;
    animation: hero-wave-sway 12s ease-in-out infinite alternate;
  }

  .hero-mix-shape {
    animation: hero-mix-float 7s ease-in-out infinite;
  }

  .hero-mix-shape-secondary {
    animation-name: hero-mix-float-secondary;
    animation-delay: -3s;
  }

  @keyframes hero-mix-float {
    0%, 100% { transform: translateY(0) rotate(12deg); }
    50% { transform: translateY(-14px) rotate(18deg); }
  }

  @keyframes hero-mix-float-secondary {
    0%, 100% { transform: translateY(0) rotate(-12deg); }
    50% { transform: translateY(12px) rotate(-6deg); }
  }

  @keyframes hero-cloud-drift-one {
    from { transform: translateX(0) translateY(0); }
    to { transform: translateX(135vw) translateY(-18px); }
  }

  @keyframes hero-cloud-drift-two {
    from { transform: translateX(0) translateY(0); }
    to { transform: translateX(140vw) translateY(14px); }
  }

  @keyframes hero-cloud-drift-three {
    from { transform: translateX(0) translateY(0); }
    to { transform: translateX(138vw) translateY(-10px); }
  }

  @keyframes hero-wave-sway {
    from { transform: translateX(-1.5%) scaleX(1.02); }
    to { transform: translateX(1.5%) scaleX(1.04); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cloud,
    .hero-wave-layer,
    .hero-mix-shape {
      animation: none;
    }
  }
</style>
