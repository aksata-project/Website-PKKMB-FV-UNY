---
// src/pages/faq.astro
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import AccordionItem from '../components/faq/AccordionItem.astro';

const faqs = [
  {
    question: 'Apa itu PKKMB dan siapa yang wajib mengikutinya?',
    answer: 'PKKMB (Pengenalan Kehidupan Kampus bagi Mahasiswa Baru) adalah kegiatan wajib yang harus diikuti oleh seluruh mahasiswa baru Fakultas Vokasi UNY pada tahun ajaran 2026/2027. Kegiatan ini dirancang untuk membantu mahasiswa baru beradaptasi dengan lingkungan perkuliahan, budaya akademik, dan kehidupan organisasi di kampus.',
  },
  {
    question: 'Kapan dan di mana kegiatan PKKMB FV UNY 2026 dilaksanakan?',
    answer: 'PKKMB FV UNY 2026 akan dilaksanakan pada 20–23 Agustus 2026. Kegiatan dipusatkan di dua kampus Fakultas Vokasi UNY, yaitu Kampus Wates (Kulon Progo) dan Kampus Gunungkidul. Detail lokasi per hari akan diinformasikan saat Technical Meeting.',
  },
  {
    question: 'Bagaimana cara mendaftar PKKMB FV UNY 2026?',
    answer: 'Pendaftaran dilakukan secara online melalui portal resmi PKKMB FV UNY 2026. Kunjungi halaman Panduan di website ini untuk melihat langkah-langkah pendaftaran secara detail, mulai dari pengisian formulir hingga pengunggahan dokumen persyaratan.',
  },
  {
    question: 'Dokumen apa saja yang perlu dipersiapkan untuk pendaftaran?',
    answer: 'Dokumen yang perlu disiapkan antara lain: (1) Foto formal terbaru dengan latar belakang merah/biru, (2) Kartu Tanda Mahasiswa Baru (sementara) atau surat keterangan diterima, (3) Surat keterangan sehat dari dokter/puskesmas, dan (4) Data diri lengkap (KTP/KK). Semua dokumen dalam format JPG atau PDF dengan ukuran maksimal 2MB.',
  },
  {
    question: 'Apa yang harus dipakai saat PKKMB?',
    answer: 'Dresscode PKKMB terbagi per hari: Hari 1 (Pembukaan) — kemeja putih polos + celana/rok hitam formal + sepatu pantofel hitam. Hari 2 (Kegiatan Utama) — kaos peserta PKKMB yang diberikan panitia + celana panjang hitam + sepatu olahraga. Hari 3 (Penutupan) — pakaian formal terbaik. Detail lengkap ada di halaman Panduan dan akan dikonfirmasi saat Technical Meeting.',
  },
  {
    question: 'Apakah ada kegiatan yang wajib dihadiri?',
    answer: 'Ya, seluruh rangkaian kegiatan PKKMB bersifat wajib dihadiri. Ketidakhadiran tanpa alasan yang sah dapat mempengaruhi status kelulusan PKKMB. Jika ada keperluan mendesak, harap melapor kepada panitia sebelum kegiatan berlangsung.',
  },
  {
    question: 'Apakah ada biaya untuk mengikuti PKKMB?',
    answer: 'PKKMB FV UNY 2026 tidak dipungut biaya tambahan di luar ketentuan kampus. Biaya administrasi telah tercakup dalam biaya pendidikan. Namun, peserta perlu mempersiapkan perlengkapan pribadi sesuai dresscode dan kebutuhan kegiatan yang akan diinformasikan lebih lanjut.',
  },
  {
    question: 'Bagaimana jika saya memiliki kondisi kesehatan tertentu?',
    answer: 'Peserta dengan kondisi kesehatan khusus (alergi, penyakit kronis, dll.) wajib melaporkan kondisinya kepada panitia saat pendaftaran atau Technical Meeting. Panitia akan memberikan penyesuaian yang diperlukan demi keselamatan dan kenyamanan seluruh peserta.',
  },
  {
    question: 'Di mana saya bisa mendapatkan informasi terbaru tentang PKKMB?',
    answer: 'Informasi terbaru PKKMB FV UNY 2026 dapat diikuti melalui: (1) Website resmi ini, (2) Instagram resmi @pkkmbfvuny2026, (3) WhatsApp Group peserta yang akan dibentuk setelah pendaftaran ditutup, dan (4) Pengumuman resmi dari kampus melalui portal mahasiswa.',
  },
  {
    question: 'Apakah orang tua/wali boleh mendampingi saat PKKMB?',
    answer: 'Orang tua/wali dipersilakan mengantar mahasiswa baru di hari pertama (Upacara Pembukaan). Namun, selama rangkaian kegiatan berlangsung, area kegiatan hanya dapat diakses oleh peserta dan panitia. Hal ini dilakukan agar peserta dapat lebih mandiri dan fokus dalam mengikuti kegiatan.',
  },
];
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FAQ PKKMB FV UNY 2026 — Cokro Aksata</title>
    <meta name="description" content="Pertanyaan yang sering diajukan seputar PKKMB Fakultas Vokasi Universitas Negeri Yogyakarta 2026." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400..700&family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..800&family=Sniglet:wght@400;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-cokro-tint text-cokro-navy font-body antialiased overflow-x-hidden selection:bg-cokro-gold selection:text-cokro-navy">
    <Navbar />

    <PageHeader
      title="Pertanyaan Umum"
      subtitle="Temukan jawaban atas pertanyaan yang paling sering ditanyakan seputar PKKMB FV UNY 2026 di sini."
      badge="FAQ"
    />

    <main class="py-20 px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-black text-3xl md:text-4xl text-cokro-navy mb-4">{faqs.length} Pertanyaan Terjawab</h2>
          <div class="w-20 h-1.5 bg-cokro-gold rounded-pill mx-auto"></div>
        </div>

        <!-- Accordion List -->
        <div class="space-y-4">
          {faqs.map((faq, i) => (
            <AccordionItem
              question={faq.question}
              answer={faq.answer}
              index={i}
            />
          ))}
        </div>

        <!-- Still have questions CTA -->
        <div class="mt-16 bg-white rounded-card-lg border-2 border-cokro-navy shadow-3d-solid-lg p-8 text-center">
          <div class="text-5xl mb-4">💬</div>
          <h3 class="font-display font-black text-2xl text-cokro-navy mb-3">Masih ada pertanyaan?</h3>
          <p class="font-body text-cokro-text-muted mb-6 max-w-md mx-auto">Jangan ragu untuk menghubungi panitia PKKMB FV UNY 2026 melalui media sosial kami.</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="https://www.instagram.com/pkkmbfvuny2026"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-purple-500 to-pink-500 text-white font-display font-bold rounded-pill border-2 border-cokro-navy shadow-3d-solid hover:-translate-y-1 hover:shadow-3d-solid-hover transition-all duration-200"
            >
              📸 Instagram Kami
            </a>
            <a
              href="mailto:pkkmbfvuny2026@uny.ac.id"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-cokro-gold text-cokro-navy font-display font-bold rounded-pill border-2 border-cokro-navy shadow-3d-solid hover:-translate-y-1 hover:shadow-3d-solid-hover transition-all duration-200"
            >
              ✉️ Email Kami
            </a>
          </div>
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>
